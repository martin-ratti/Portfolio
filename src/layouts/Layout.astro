---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ChatWidget from "../components/ChatWidget.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
	title,
	description = t('seo.description'),
	image = "/og-image.png",
	noindex = false,
	jsonLd = [],
} = Astro.props;

const siteUrl = "https://martinratti.com.ar";
const normalizePath = (p: string) => p.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const cleanPath = normalizePath(currentPath.replace(/^\/en(\/|$)/, "/"));
const enPath = cleanPath === "/" ? "/en" : `/en${cleanPath}`;

const alternates = {
	es: new URL(cleanPath, siteUrl).href,
	en: new URL(enPath, siteUrl).href,
};
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImageUrl = new URL("/og-image.png", siteUrl).href;
const pageImageUrl = new URL(image, siteUrl).href;
const isDefaultOg = image === "/og-image.png";
const pageImageType = image.toLowerCase().endsWith(".webp") ? "image/webp" : undefined;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#7c3aed" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="light dark" />
		<meta name="author" content="Martín Ratti" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
		<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_AR'} />
		<meta property="og:site_name" content="Martín Ratti — Portfolio" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{
			isDefaultOg ? (
				<>
					<meta property="og:image" content={ogImageUrl} />
					<meta property="og:image:type" content="image/png" />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta property="og:image:alt" content={title} />
				</>
			) : (
				<>
					<meta property="og:image" content={pageImageUrl} />
					{pageImageType && <meta property="og:image:type" content={pageImageType} />}
					<meta property="og:image:alt" content={title} />
					<meta property="og:image" content={ogImageUrl} />
					<meta property="og:image:type" content="image/png" />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
				</>
			)
		}

		{
			!noindex && (
				<>
					<link rel="canonical" href={canonicalUrl} />
					<link rel="alternate" hreflang="es" href={alternates.es} />
					<link rel="alternate" hreflang="en" href={alternates.en} />
					<link rel="alternate" hreflang="x-default" href={alternates.en} />
				</>
			)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={pageImageUrl} />
		<ClientRouter />
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Martín Ratti",
			"url": siteUrl,
			"image": ogImageUrl,
			"jobTitle": "Full Stack Developer",
			"description": description,
			"sameAs": [
				"https://github.com/martin-ratti",
				"https://www.linkedin.com/in/martin-ratti-dev/"
			],
			"knowsAbout": [
				"Astro", "React", "TypeScript", "Node.js", "Express",
				".NET", "C#", "Java", "Kotlin", "Android", "Jetpack Compose",
				"Python", "PostgreSQL", "MySQL", "SQL Server", "Firebase",
				"Tailwind CSS", "Docker", "Prisma"
			],
			"alumniOf": {
				"@type": "CollegeOrUniversity",
				"name": "Universidad Tecnológica Nacional - Facultad Regional Rosario",
				"url": "https://www.frro.utn.edu.ar/"
			},
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "AR",
				"addressLocality": "Rosario"
			}
		})} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Martín Ratti — Portfolio",
			"url": siteUrl,
			"inLanguage": [lang === 'es' ? 'es-AR' : 'en-US'],
			"author": { "@type": "Person", "name": "Martín Ratti" }
		})} />
		{
			jsonLd.map((schema) => (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
			))
		}
		<script is:inline defer src="/_vercel/insights/script.js"></script>
		<script is:inline defer src="/_vercel/speed-insights/script.js"></script>
		<title>{title}</title>
	</head>
	<body
		class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-white selection:bg-fuchsia-500/30 relative"
	>
		<a href="#main-content" class="skip-link">{t('nav.skip')}</a>
		<div
			class="fixed inset-0 -z-10 h-full w-full bg-slate-50 dark:bg-slate-950"
		>
			<div
				class="absolute top-0 z-[-2] h-screen w-screen bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
			>
			</div>
			<div
				class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-size-[14px_24px] mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
			>
			</div>
		</div>

		<script is:inline>
			(() => {
				const syncTheme = () => {
					let stored = null;
					try {
						stored = localStorage.getItem("theme");
					} catch {}
					const meta = document.querySelector('meta[name="color-scheme"]');
					const isValidOverride = stored === "dark" || stored === "light";
					if (meta) {
						meta.setAttribute("content", isValidOverride ? stored : "light dark");
					}
					const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					const resolvedDark = isValidOverride ? stored === "dark" : prefersDark;
					document.documentElement.classList.toggle("dark", resolvedDark);
				};

				syncTheme();

				if (!window.__portfolioThemeListenersAttached) {
					window.__portfolioThemeListenersAttached = true;
					document.addEventListener("astro:after-swap", syncTheme);
					window.addEventListener("storage", (e) => {
						if (e.key === "theme") syncTheme();
					});
					window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
						let stored = null;
						try {
							stored = localStorage.getItem("theme");
						} catch {}
						if (stored !== "dark" && stored !== "light") syncTheme();
					});
				}
			})();
		</script>

		<slot />

		<script>
			let spotlightController: AbortController | null = null;
			let spotlightObserver: IntersectionObserver | null = null;
			let spotlightRafId: number | null = null;

			const cleanupSpotlight = () => {
				if (spotlightController) {
					spotlightController.abort();
					spotlightController = null;
				}
				if (spotlightObserver) {
					spotlightObserver.disconnect();
					spotlightObserver = null;
				}
				if (spotlightRafId !== null) {
					window.cancelAnimationFrame(spotlightRafId);
					spotlightRafId = null;
				}
			};

			const initSpotlight = () => {
				cleanupSpotlight();

				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduceMotion) return;

				const cards = document.querySelectorAll<HTMLElement>(".glass-card");
				if (cards.length === 0) return;

				spotlightController = new AbortController();
				const { signal } = spotlightController;

				const visibleCards = new Set<HTMLElement>();

				spotlightObserver = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						const target = entry.target as HTMLElement;
						if (entry.isIntersecting) {
							visibleCards.add(target);
						} else {
							visibleCards.delete(target);
						}
					});
				}, { threshold: 0.1 });

				cards.forEach((card) => spotlightObserver?.observe(card));

				let lastX = 0;
				let lastY = 0;

				document.addEventListener(
					"mousemove",
					(e) => {
						if (visibleCards.size === 0) return;
						lastX = e.clientX;
						lastY = e.clientY;
						if (spotlightRafId !== null) return;

						spotlightRafId = window.requestAnimationFrame(() => {
							spotlightRafId = null;
							visibleCards.forEach((card) => {
								const rect = card.getBoundingClientRect();
								const x = lastX - rect.left;
								const y = lastY - rect.top;
								card.style.setProperty("--mouse-x", `${x}px`);
								card.style.setProperty("--mouse-y", `${y}px`);
							});
						});
					},
					{ passive: true, signal },
				);
			};

			document.addEventListener("astro:before-swap", cleanupSpotlight);
			document.addEventListener("astro:page-load", initSpotlight);
		</script>
		<ChatWidget />
	</body>
</html>
