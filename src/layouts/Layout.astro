---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
	title: string;
	description?: string;
}

import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
	title,
	description = t('seo.description'),
} = Astro.props;

const siteUrl = "https://martinratti.com.ar";
// Lógica para rutas alternativas: limpia /en del inicio para obtener la ruta base
const cleanPath = Astro.url.pathname.replace(/^\/en(\/|$)/, "$1") || "/";
const alternates = {
    es: new URL(cleanPath, siteUrl).href,
    en: new URL("/en" + (cleanPath.startsWith("/") ? cleanPath : "/" + cleanPath), siteUrl).href,
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#7c3aed" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="light dark" />
		<meta name="author" content="Martín Ratti" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
		<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_AR'} />
		<meta property="og:site_name" content="Martín Ratti — Portfolio" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/og-image.svg', siteUrl).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Martín Ratti — Full Stack Developer" />

		<!-- SEO Expansion 1: Bidirectional Semantic Connection (hreflang) -->
		<link rel="canonical" href={lang === 'es' ? alternates.es : alternates.en} />
		<link rel="alternate" hreflang="es" href={alternates.es} />
		<link rel="alternate" hreflang="en" href={alternates.en} />
		<link rel="alternate" hreflang="x-default" href={alternates.en} />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/og-image.svg', siteUrl).href} />
		<ClientRouter />
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Martín Ratti",
			"url": siteUrl,
			"image": new URL('/og-image.svg', siteUrl).href,
			"jobTitle": "Full Stack Developer",
			"description": description,
			"email": "mailto:martinratti10@gmail.com",
			"sameAs": [
				"https://github.com/martin-ratti",
				"https://www.linkedin.com/in/martin-ratti-dev/"
			],
			"knowsAbout": [
				"Astro", "React", "TypeScript", "Node.js", "Express",
				".NET", "C#", "Java", "Python", "PostgreSQL", "SQL Server",
				"Tailwind CSS", "Docker", "Prisma"
			],
			"alumniOf": {
				"@type": "CollegeOrUniversity",
				"name": "Universidad Tecnológica Nacional - Facultad Regional Rosario",
				"url": "https://www.frro.utn.edu.ar/"
			},
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "AR",
				"addressLocality": "Rosario"
			}
		})} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Martín Ratti — Portfolio",
			"url": siteUrl,
			"inLanguage": [lang === 'es' ? 'es-AR' : 'en-US'],
			"author": { "@type": "Person", "name": "Martín Ratti" }
		})} />
		<script defer src="/_vercel/insights/script.js"></script>
		<script defer src="/_vercel/speed-insights/script.js"></script>
		<title>{title}</title>
	</head>
	<body
		class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-white selection:bg-fuchsia-500/30 relative"
	>
		<a href="#main-content" class="skip-link">{t('nav.skip')}</a>
		<div
			class="fixed inset-0 -z-10 h-full w-full bg-slate-50 dark:bg-slate-950"
		>
			<div
				class="absolute top-0 z-[-2] h-screen w-screen bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
			>
			</div>
			<div
				class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-size-[14px_24px] mask-[radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
			>
			</div>
		</div>

		<script is:inline>
			const getTheme = () => {
				if (
					typeof localStorage !== "undefined" &&
					localStorage.getItem("theme")
				) {
					return localStorage.getItem("theme");
				}
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					return "dark";
				}
				return "light";
			};
			const applyTheme = () => {
				const theme = getTheme();
				if (theme === "dark") {
					document.documentElement.classList.add("dark");
				} else {
					document.documentElement.classList.remove("dark");
				}
				window.localStorage.setItem("theme", theme);
			};
			applyTheme();
			document.addEventListener("astro:after-swap", applyTheme);
		</script>

		<slot />

		<script>
			let spotlightController: AbortController | null = null;

			const initSpotlight = () => {
				if (spotlightController) spotlightController.abort();

				const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				if (reduceMotion) return;

				const cards = document.querySelectorAll(".glass-card");
				if (cards.length === 0) return;

				spotlightController = new AbortController();
				const { signal } = spotlightController;

				const visibleCards = new Set<Element>();

				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							visibleCards.add(entry.target);
						} else {
							visibleCards.delete(entry.target);
						}
					});
				}, { threshold: 0.1 });

				cards.forEach(card => observer.observe(card));

				document.addEventListener(
					"mousemove",
					(e) => {
						if (visibleCards.size === 0) return;

						window.requestAnimationFrame(() => {
							visibleCards.forEach((card: any) => {
								const rect = card.getBoundingClientRect();
								const x = e.clientX - rect.left;
								const y = e.clientY - rect.top;
								card.style.setProperty("--mouse-x", `${x}px`);
								card.style.setProperty("--mouse-y", `${y}px`);
							});
						});
					},
					{ passive: true, signal },
				);
			};

			const initThemeTransitions = () => {
				// UI/UX Expansion 4: Transición sin destellos
				setTimeout(() => {
					document.body.classList.add('theme-transitions-ready');
				}, 100);
			};

			initSpotlight();
			initThemeTransitions();
			document.addEventListener("astro:after-swap", () => {
				initSpotlight();
				initThemeTransitions();
			});
		</script>
		<ChatWidget />
	</body>
</html>
