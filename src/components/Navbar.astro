---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === "en";
const cvHref = isEn ? "/CV_Martin_Ratti_EN.pdf" : "/CV_Martin_Ratti.pdf";

const normalizePath = (p: string) => p.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const homePath = isEn ? "/en" : "/";
const isHomePage = currentPath === homePath;
const anchorPrefix = isHomePage ? "" : homePath;

const navItems = [
    { name: t("nav.about"), url: `${anchorPrefix}#sobre-mi` },
    { name: t("nav.stack"), url: `${anchorPrefix}#stack` },
    { name: t("nav.projects"), url: `${anchorPrefix}#proyectos` },
    { name: t("nav.contact"), url: `${anchorPrefix}#contacto` },
];

const basePath = normalizePath(currentPath.replace(/^\/en(\/|$)/, "/"));
const targetLangUrl = isEn ? basePath : (basePath === "/" ? "/en" : `/en${basePath}`);
---

<nav
    aria-label={t("nav.aria")}
    class="fixed top-4 left-0 right-0 z-50 flex justify-center px-4 pointer-events-none"
>
    <div class="relative pointer-events-auto max-w-[95vw]">
        <!-- Fades para scroll horizontal en móvil -->
        <div
            id="nav-fade-left"
            class="absolute left-0 top-0 bottom-0 w-12 bg-linear-to-r from-slate-900/40 dark:from-black/60 to-transparent z-10 opacity-0 transition-opacity pointer-events-none rounded-l-full"
        >
        </div>
        <div
            id="nav-fade-right"
            class="absolute right-0 top-0 bottom-0 w-12 bg-linear-to-l from-slate-900/40 dark:from-black/60 to-transparent z-10 opacity-0 transition-opacity pointer-events-none rounded-r-full"
        >
        </div>

        <div
            id="nav-container"
            class="glass-card rounded-full px-3 py-2 md:px-6 md:py-3 flex items-center gap-2 md:gap-8 shadow-lg shadow-violet-900/10 overflow-x-auto no-scrollbar relative"
        >
            <a
                href={homePath}
                class="font-bold text-transparent bg-clip-text bg-linear-to-r from-violet-400 to-cyan-400 hover:opacity-80 transition shrink-0"
                >MR</a
            >

            <div class="h-4 w-px bg-slate-700/50 hidden md:block"></div>

            <ul class="nav-scroll-group flex gap-3 md:gap-6 shrink-0">
                {
                    navItems.map((item) => (
                        <li>
                            <a
                                href={item.url}
                                class="nav-link text-xs md:text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap"
                            >
                                {item.name}
                            </a>
                        </li>
                    ))
                }
            </ul>

            <div class="h-4 w-px bg-slate-700/50 hidden md:block"></div>

            <div class="flex gap-1 md:gap-4 items-center shrink-0">
                <a
                    href="https://github.com/martin-ratti"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-400 hover:text-white transition hidden sm:block delay-75"
                    aria-label="GitHub"
                >
                    <Icon name="simple-icons:github" class="w-5 h-5" />
                </a>

                <a
                    id="lang-toggle"
                    href={targetLangUrl}
                    aria-label={t("nav.lang.aria")}
                    class="text-[10px] md:text-xs font-bold text-slate-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-white transition uppercase border border-slate-300 dark:border-slate-700 px-1.5 py-0.5 md:px-2 md:py-1 rounded"
                >
                    {lang === "es" ? "EN" : "ES"}
                </a>

                <button
                    id="theme-toggle"
                    type="button"
                    class="p-1.5 md:p-3 text-slate-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-white transition rounded-full hover:bg-slate-100 dark:hover:bg-slate-800"
                    aria-label={t("nav.theme.toggle")}
                    aria-pressed="false"
                    data-label-dark={t("nav.theme.dark")}
                    data-label-light={t("nav.theme.light")}
                >
                    <Icon
                        id="sun-icon"
                        name="mdi:weather-sunny"
                        class="hidden dark:block w-5 h-5 md:w-6 md:h-6"
                    />
                    <Icon
                        id="moon-icon"
                        name="mdi:weather-night"
                        class="block dark:hidden w-5 h-5 md:w-6 md:h-6"
                    />
                </button>

                <a
                    href={cvHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hidden sm:block text-xs font-medium text-violet-600 dark:text-violet-300 hover:text-violet-700 dark:hover:text-white border border-violet-500/30 bg-violet-500/10 px-3 py-1.5 rounded-full transition"
                    aria-label={t("nav.cv.aria")}
                >
                    {t("nav.cv")}
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    let navAbortController: AbortController | null = null;
    let navObserver: IntersectionObserver | null = null;
    let themeTransitionTimer: ReturnType<typeof setTimeout> | null = null;

    const normalizePath = (p: string) => p.replace(/\/+$/, "") || "/";

    function getSamePageHash(link: Element): string | null {
        const href = (link as HTMLAnchorElement).href;
        if (!href) return null;
        try {
            const url = new URL(href, window.location.origin);
            if (
                url.origin === window.location.origin &&
                normalizePath(url.pathname) === normalizePath(window.location.pathname) &&
                url.hash
            ) {
                return url.hash;
            }
        } catch {
            return null;
        }
        return null;
    }

    function cleanupNavbar() {
        if (navAbortController) {
            navAbortController.abort();
            navAbortController = null;
        }
        if (navObserver) {
            navObserver.disconnect();
            navObserver = null;
        }
        if (themeTransitionTimer !== null) {
            clearTimeout(themeTransitionTimer);
            themeTransitionTimer = null;
            document.body?.classList.remove("theme-transitions-ready");
        }
    }

    function initNavbar() {
        cleanupNavbar();
        navAbortController = new AbortController();
        const { signal } = navAbortController;

        const themeToggle = document.getElementById("theme-toggle");

        const updateThemeAria = () => {
            if (!themeToggle) return;
            const isDark = document.documentElement.classList.contains("dark");
            const label = isDark ? themeToggle.dataset.labelDark : themeToggle.dataset.labelLight;

            themeToggle.setAttribute("aria-pressed", isDark ? "true" : "false");
            if (label) themeToggle.setAttribute("aria-label", label);
        };

        const handleToggleClick = () => {
            if (themeTransitionTimer !== null) {
                clearTimeout(themeTransitionTimer);
            }
            document.body.classList.add("theme-transitions-ready");

            const element = document.documentElement;
            const currentlyDark = element.classList.contains("dark");
            const targetTheme = currentlyDark ? "light" : "dark";
            const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
            const meta = document.querySelector('meta[name="color-scheme"]');

            try {
                if (targetTheme === systemTheme) {
                    localStorage.removeItem("theme");
                    meta?.setAttribute("content", "light dark");
                } else {
                    localStorage.setItem("theme", targetTheme);
                    meta?.setAttribute("content", targetTheme);
                }
            } catch {
                meta?.setAttribute("content", targetTheme);
            }

            element.classList.toggle("dark", targetTheme === "dark");
            updateThemeAria();

            themeTransitionTimer = setTimeout(() => {
                document.body.classList.remove("theme-transitions-ready");
                themeTransitionTimer = null;
            }, 320);
        };

        themeToggle?.addEventListener("click", handleToggleClick, { signal });
        updateThemeAria();

        // Scroll Indicators Logic
        const navContainer = document.getElementById("nav-container");
        const fadeLeft = document.getElementById("nav-fade-left");
        const fadeRight = document.getElementById("nav-fade-right");

        if (navContainer && fadeLeft && fadeRight) {
            const updateFades = () => {
                const scrollLeft = navContainer.scrollLeft;
                const scrollWidth = navContainer.scrollWidth;
                const clientWidth = navContainer.clientWidth;

                fadeLeft.style.opacity = scrollLeft > 10 ? "1" : "0";
                fadeRight.style.opacity =
                    scrollLeft + clientWidth < scrollWidth - 10 ? "1" : "0";
            };

            navContainer.addEventListener("scroll", updateFades, { passive: true, signal });
            updateFades();
            window.addEventListener("resize", updateFades, { passive: true, signal });
        }

        // Language toggle persistence
        const langToggle = document.getElementById("lang-toggle");

        function updateLangHref() {
            if (!langToggle) return;
            const hash = window.location.hash;
            const currentHref = langToggle.getAttribute("href") || "";
            const baseHref = currentHref.split("#")[0];
            if (hash) {
                langToggle.setAttribute("href", baseHref + hash);
            } else {
                langToggle.setAttribute("href", baseHref);
            }
        }

        if (langToggle) {
            updateLangHref();
            window.addEventListener("hashchange", updateLangHref, { signal });
        }

        // Scroll Spy & Anchor Click Logic
        const navLinks = document.querySelectorAll(".nav-link");
        const sections = document.querySelectorAll("section[id]");

        if (navLinks.length === 0) return;

        const syncActiveHash = (hash: string | null) => {
            if (hash && hash.startsWith("#") && window.location.hash !== hash) {
                history.replaceState(history.state, "", hash);
                updateLangHref();
            }
        };

        if (sections.length > 0) {
            const supportsScrollTargetGroup =
                typeof CSS !== "undefined" &&
                typeof CSS.supports === "function" &&
                CSS.supports("scroll-target-group: auto");

            if (supportsScrollTargetGroup) {
                const syncAriaCurrent = () => {
                    const currentLink = document.querySelector(".nav-link:target-current");
                    navLinks.forEach((link) => {
                        if (link === currentLink) {
                            link.setAttribute("aria-current", "location");
                        } else {
                            link.removeAttribute("aria-current");
                        }
                    });
                    if (currentLink) {
                        syncActiveHash(getSamePageHash(currentLink));
                    }
                };
                syncAriaCurrent();
                document.addEventListener("scrollend", syncAriaCurrent, { passive: true, signal });
            } else {
                const observerOptions = {
                    root: null,
                    rootMargin: "-20% 0px -50% 0px",
                    threshold: 0,
                };

                const observerCallback = (entries: IntersectionObserverEntry[]) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            const activeId = entry.target.getAttribute("id");

                            navLinks.forEach((link) => {
                                const hash = getSamePageHash(link);
                                if (hash) {
                                    const isActive = hash === `#${activeId}`;
                                    link.classList.toggle("target-current", isActive);
                                    if (isActive) {
                                        link.setAttribute("aria-current", "location");
                                        syncActiveHash(hash);
                                    } else {
                                        link.removeAttribute("aria-current");
                                    }
                                }
                            });
                        }
                    });
                };

                navObserver = new IntersectionObserver(
                    observerCallback,
                    observerOptions,
                );

                sections.forEach((section) => {
                    navObserver?.observe(section);
                });
            }
        }

        // Click Handler for Same-Page Smooth Scroll
        navLinks.forEach((link) => {
            link.addEventListener("click", (e) => {
                const hash = getSamePageHash(link);
                if (!hash) return;

                const targetId = hash.slice(1);
                const targetElement = document.getElementById(targetId);
                if (targetElement) {
                    e.preventDefault();
                    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                    targetElement.scrollIntoView({
                        behavior: reduceMotion ? "auto" : "smooth",
                        block: "start",
                    });
                    history.replaceState(history.state, "", hash);
                    updateLangHref();
                }
            }, { signal });
        });
    }

    document.addEventListener("astro:before-swap", cleanupNavbar);
    document.addEventListener("astro:page-load", initNavbar);
</script>
