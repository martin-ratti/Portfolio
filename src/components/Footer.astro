---
const currentYear = new Date().getFullYear();
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cvHref = lang === "en" ? "/CV_Martin_Ratti_EN.pdf" : "/CV_Martin_Ratti.pdf";
---

<footer
    class="py-10 border-t border-slate-200/80 dark:border-slate-900 bg-white/60 dark:bg-slate-950/60 backdrop-blur-sm text-slate-500 dark:text-slate-400 text-sm transition-colors duration-300"
>
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-5 text-center md:text-left">
        <div>
            <p class="font-medium text-slate-700 dark:text-slate-300">
                <span class="font-bold text-transparent bg-clip-text bg-linear-to-r from-violet-500 to-cyan-500 mr-2">MR</span>
                © {currentYear} Martín Ratti. {t("footer.rights")}
            </p>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                {t("footer.developed")}
                <a
                    href="https://astro.build"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-violet-600 dark:text-violet-400 hover:text-violet-500 dark:hover:text-violet-300 font-medium"
                    >Astro</a
                >
                {t("footer.and")}
                <a
                    href="https://tailwindcss.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 dark:hover:text-cyan-300 font-medium"
                    >Tailwind CSS</a
                >.
            </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-medium">
            <a
                href="https://github.com/martin-ratti"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors py-1"
            >
                <Icon name="simple-icons:github" class="w-4 h-4" aria-hidden="true" />
                <span>GitHub</span>
            </a>
            <a
                href="https://www.linkedin.com/in/martin-ratti-dev/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-[#0A66C2] dark:hover:text-[#38bdf8] transition-colors py-1"
            >
                <Icon name="simple-icons:linkedin" class="w-4 h-4" aria-hidden="true" />
                <span>LinkedIn</span>
            </a>
            <a
                href={cvHref}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t("nav.cv.aria")}
                class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-300 transition-colors py-1"
            >
                <Icon name="mdi:file-document-outline" class="w-4 h-4" aria-hidden="true" />
                <span>{t("nav.cv")}</span>
            </a>
            <a
                href="/llms.txt"
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-slate-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-300 transition-colors py-1"
            >
                llms.txt
            </a>
        </div>
    </div>

    <!-- Botón Volver Arriba -->
    <button
        id="back-to-top"
        type="button"
        class="fixed bottom-[calc(max(1rem,env(safe-area-inset-bottom))+4.25rem)] right-4 z-40 w-11 h-11 flex items-center justify-center bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-slate-200 dark:border-slate-700/80 text-slate-700 dark:text-slate-200 hover:text-violet-600 dark:hover:text-violet-300 hover:border-violet-500/50 rounded-full shadow-lg opacity-0 translate-y-4 pointer-events-none transition-[transform,opacity,color,border-color] duration-200 hover:-translate-y-0.5 active:scale-95 cursor-pointer"
        aria-label={t("footer.backToTop")}
        title={t("footer.backToTopTitle")}
    >
        <Icon name="mdi:arrow-up" class="w-5 h-5" aria-hidden="true" />
    </button>
</footer>

<script>
    let footerAbortController: AbortController | null = null;

    function cleanupBackToTop() {
        if (footerAbortController) {
            footerAbortController.abort();
            footerAbortController = null;
        }
    }

    function initBackToTop() {
        cleanupBackToTop();
        const backToTopBtn = document.getElementById("back-to-top");
        if (!backToTopBtn) return;

        footerAbortController = new AbortController();
        const { signal } = footerAbortController;

        const handleScroll = () => {
            if (window.scrollY > 400) {
                backToTopBtn.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
                backToTopBtn.classList.add("opacity-100", "translate-y-0");
            } else {
                backToTopBtn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
                backToTopBtn.classList.remove("opacity-100", "translate-y-0");
            }
        };

        window.addEventListener("scroll", handleScroll, { passive: true, signal });

        backToTopBtn.addEventListener(
            "click",
            () => {
                const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                window.scrollTo({
                    top: 0,
                    behavior: reduceMotion ? "auto" : "smooth",
                });
            },
            { signal },
        );

        handleScroll();
    }

    document.addEventListener("astro:before-swap", cleanupBackToTop);
    document.addEventListener("astro:page-load", initBackToTop);
</script>
