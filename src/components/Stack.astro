---
import { skills } from "../data/skills";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillCategories = [
    {
        title: "Frontend",
        icon: "mdi:web",
        skills: skills.frontend,
        colorClass:
            "border-violet-200 dark:border-violet-500/30 bg-violet-100/50 dark:bg-violet-500/10 text-violet-700 dark:text-violet-300 hover:bg-violet-200 dark:hover:bg-violet-500/20",
    },
    {
        title: "Backend",
        icon: "mdi:server",
        skills: skills.backend,
        colorClass:
            "border-fuchsia-200 dark:border-fuchsia-500/30 bg-fuchsia-100/50 dark:bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-300 hover:bg-fuchsia-200 dark:hover:bg-fuchsia-500/20",
    },
    {
        title: t("stack.languages"),
        icon: "mdi:code-tags",
        skills: skills.languages,
        colorClass:
            "border-cyan-200 dark:border-cyan-500/30 bg-cyan-100/50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-200 dark:hover:bg-cyan-500/20",
    },
    {
        title: t("stack.tools"),
        icon: "mdi:tools",
        skills: skills.tools,
        colorClass:
            "border-emerald-200 dark:border-emerald-500/30 bg-emerald-100/50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-200 dark:hover:bg-emerald-500/20",
    },
];
---

<section id="stack" class="py-20 px-4 relative scroll-mt-16">
    <div class="max-w-6xl mx-auto">
        <h2
            class="text-3xl font-bold mb-4 text-center text-slate-900 dark:text-white"
        >
            {t("stack.title")}
        </h2>
        <p
            class="text-slate-500 dark:text-slate-400 text-center mb-12 text-sm max-w-md mx-auto flex items-center justify-center gap-1"
        >
            <Icon name="mdi:lightbulb-outline" class="w-4 h-4 text-amber-500 shrink-0" aria-hidden="true" />
            {t("stack.instruction")}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                skillCategories.map((category) => (
                    <div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
                        <div
                            class={`absolute -right-4 -top-4 w-24 h-24 rounded-full blur-2xl opacity-20 ${category.colorClass.split(" ")[1].replace("/10", "/30")}`}
                        />

                        <div class="flex items-center gap-2 mb-6">
                            <Icon 
                                name={category.icon} 
                                class={`w-6 h-6 ${category.colorClass.split(" ").find(c => c.startsWith("text-"))}`} 
                                aria-hidden="true"
                            />
                            <h3 class="text-xl font-semibold text-slate-800 dark:text-slate-200">
                                {category.title}
                            </h3>
                        </div>

                        <div class="flex flex-wrap gap-3">
                            {category.skills.map((skill) => (
                                <button
                                    class={`skill-btn px-4 py-2 rounded-lg text-sm font-medium border transition-all cursor-pointer hover:scale-105 active:scale-95 flex items-center gap-2 ${category.colorClass}`}
                                    data-skill={skill.name}
                                    aria-label={`Filtrar proyectos por ${skill.name}`}
                                >
                                    <Icon name={skill.icon} class="w-4 h-4" aria-hidden="true" />
                                    {skill.name}
                                </button>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    let activeSkill: string | null = null;
    let abortController: AbortController | null = null;

    const ACTIVE_CLASSES = ["ring-2", "ring-offset-2", "ring-violet-500", "scale-105"];

    function resetSkills() {
        activeSkill = null;
        document.querySelectorAll(".skill-btn").forEach((b) => {
            b.classList.remove(...ACTIVE_CLASSES, "opacity-50");
            b.classList.add("opacity-100");
        });
    }

    function highlightSkill(skill: string) {
        document.querySelectorAll(".skill-btn").forEach((b) => {
            const match = b.getAttribute("data-skill") === skill;
            if (match) {
                b.classList.add(...ACTIVE_CLASSES);
                b.classList.remove("opacity-50", "opacity-100");
            } else {
                b.classList.remove(...ACTIVE_CLASSES, "opacity-100");
                b.classList.add("opacity-50");
            }
        });
    }

    function initStackFilter() {
        if (abortController) abortController.abort();
        abortController = new AbortController();
        const { signal } = abortController;

        const buttons = document.querySelectorAll(".skill-btn");
        buttons.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const skill = (btn as HTMLElement).getAttribute("data-skill");

                if (activeSkill === skill) {
                    resetSkills();
                } else {
                    activeSkill = skill;
                    if (skill) highlightSkill(skill);
                }

                window.dispatchEvent(
                    new CustomEvent("filter-projects", {
                        detail: { skill: activeSkill },
                    }),
                );
            }, { signal });
        });

        document.addEventListener("click", (e: MouseEvent) => {
            const target = e.target as HTMLElement;
            if (!target || (!target.closest(".skill-btn") && activeSkill)) {
                resetSkills();
                window.dispatchEvent(
                    new CustomEvent("filter-projects", {
                        detail: { skill: null },
                    }),
                );
            }
        }, { signal });
    }

    document.addEventListener("astro:page-load", initStackFilter);
</script>
