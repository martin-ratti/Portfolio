---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { Project } from "../data/projects";

interface Props {
    project: Project;
    index: number;
    featured?: boolean;
    baseDelay?: number;
}

const { project, index, featured = false, baseDelay = 0 } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const delay = (baseDelay + index * 0.1).toFixed(1);
const detailUrl = lang === "en" ? `/en/proyectos/${project.slug}` : `/proyectos/${project.slug}`;
---

<article
    class={`project-card glass-card rounded-2xl p-5 md:p-6 hover:border-violet-500/50 transition-all duration-500 group relative overflow-hidden animate-fade-in-up flex flex-col h-full ${featured ? "border-violet-500/20" : ""}`}
    style={`animation-delay: ${delay}s`}
    data-techs={JSON.stringify(project.tags)}
>
    <!-- Background hover glow -->
    <div class="absolute inset-0 bg-linear-to-br from-violet-500/5 via-cyan-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

    <!-- Clickable card area link for the detail page -->
    <a
        href={detailUrl}
        class="absolute inset-0 z-10 focus:outline-none focus:ring-2 focus:ring-violet-500 rounded-2xl"
        aria-label={`${t("project.viewStudy")}: ${project.title}`}
    >
        <span class="sr-only">{t("project.viewStudy")}: {project.title}</span>
    </a>

    <!-- Visual Thumbnail Container with Hover Micro-interaction -->
    <div class="relative w-full aspect-video rounded-xl overflow-hidden mb-4 bg-slate-900/50 border border-slate-700/50 shadow-inner group/thumb">
        <img
            src={project.coverImage}
            alt={project.title}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top transform group-hover:scale-105 transition-transform duration-500 ease-out"
            transition:name={`project-cover-${project.slug}`}
        />
        
        <!-- Hover Overlay with View Case Study Pill -->
        <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center p-3">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-white bg-violet-600/90 backdrop-blur-md shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                {t("project.viewStudy")}
            </span>
        </div>

        {
            featured && (
                <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-md text-[11px] font-bold tracking-wider uppercase bg-violet-600/90 text-white backdrop-blur-md shadow-md border border-violet-400/30">
                    Featured
                </span>
            )
        }
    </div>

    <!-- Content & Action Header -->
    <div class="relative z-10 flex flex-col grow">
        <div class="flex justify-between items-start gap-3 mb-2">
            <h3
                class={`font-bold text-slate-900 dark:text-white group-hover:text-violet-600 dark:group-hover:text-violet-300 transition-colors line-clamp-2 ${featured ? "text-xl md:text-2xl" : "text-lg"}`}
            >
                {project.title}
            </h3>

            <!-- External Action Links (Isolated with z-20 to avoid triggering card navigation) -->
            <div class="flex gap-1.5 shrink-0 relative z-20">
                <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 bg-slate-100 dark:bg-slate-800/80 rounded-full hover:bg-slate-200 dark:hover:bg-violet-900/50 hover:text-violet-600 dark:hover:text-violet-300 transition text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700/50"
                    aria-label={`GitHub Repo: ${project.title}`}
                    title="GitHub Repository"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width={featured ? "18" : "16"}
                        height={featured ? "18" : "16"}
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                        ></path>
                    </svg>
                </a>
                {
                    project.link && (
                        <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-2 bg-violet-600 hover:bg-violet-500 rounded-full transition text-white shadow-md shadow-violet-600/20"
                            aria-label={`Live Demo: ${project.title}`}
                            title="Live Demo"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width={featured ? "18" : "16"}
                                height={featured ? "18" : "16"}
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                <polyline points="15 3 21 3 21 9" />
                                <line x1="10" y1="14" x2="21" y2="3" />
                            </svg>
                        </a>
                    )
                }
            </div>
        </div>

        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4 grow line-clamp-3">
            {project.description[lang]}
        </p>

        <!-- Tech Tags -->
        <div class="flex flex-wrap gap-1.5 pt-2">
            {
                project.tags
                    .slice(0, 3)
                    .map((tag) => (
                        <span class="px-2.5 py-0.5 text-[11px] font-medium text-violet-600 dark:text-violet-300 bg-violet-100 dark:bg-violet-900/30 rounded-full border border-violet-200 dark:border-violet-800/50">
                            {tag}
                        </span>
                    ))
            }
            {
                project.tags.length > 3 && (
                    <span
                        class="px-2.5 py-0.5 text-[11px] font-medium text-violet-600 dark:text-violet-300 bg-violet-100 dark:bg-violet-900/30 rounded-full border border-violet-200 dark:border-violet-800/50"
                        title={project.tags.slice(3).join(", ")}
                    >
                        +{project.tags.length - 3}
                    </span>
                )
            }
        </div>

        <!-- Case Study Link Footer -->
        <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center justify-between text-xs font-semibold text-violet-600 dark:text-violet-400 group-hover:text-violet-500 dark:group-hover:text-violet-300 transition-colors">
            <span>{t("project.viewStudy")}</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
            </svg>
        </div>
    </div>
</article>
