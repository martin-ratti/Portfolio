---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cvHref = lang === "en" ? "/CV_Martin_Ratti_EN.pdf" : "/CV_Martin_Ratti.pdf";
---

<section
    id="inicio"
    class="min-h-[86svh] sm:min-h-[90vh] flex flex-col justify-center items-center text-center px-4 relative overflow-hidden pt-24 pb-12 md:pt-32"
>
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-violet-600/25 dark:bg-violet-600/30 rounded-full blur-[100px] -z-10 pointer-events-none"
        aria-hidden="true"
    >
    </div>

    <div class="space-y-5 sm:space-y-6 max-w-4xl z-10 w-full">
        <div class="animate-fade-in-up" style="animation-delay: 0.1s">
            <span
                class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-100/60 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/80 rounded-full"
            >
                <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.65)]" aria-hidden="true"></span>
                {t("hero.available")}
            </span>
        </div>

        <h1
            class="text-5xl sm:text-7xl md:text-8xl font-bold tracking-tight text-slate-900 dark:text-white leading-[1.08]"
        >
            {t("hero.greeting")}
            <br />
            <span class="text-gradient">Martín Ratti</span>
        </h1>

        <p
            class="text-lg sm:text-xl md:text-2xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto animate-fade-in-up leading-relaxed"
            style="animation-delay: 0.3s"
        >
            {t("hero.role")}
            <span
                class="inline-flex min-w-[100px] sm:min-w-[120px] justify-start text-left relative"
            >
                <span id="typewriter-text" class="font-bold text-violet-600 dark:text-violet-400">Astro</span>
                <span id="typewriter-cursor" class="animate-blink ml-1" aria-hidden="true">|</span>
            </span>
        </p>

        <script>
            const words = [
                {
                    text: "Astro",
                    color: "text-violet-600 dark:text-violet-400",
                },
                { text: "React", color: "text-cyan-600 dark:text-cyan-400" },
                {
                    text: "Node.js",
                    color: "text-emerald-600 dark:text-emerald-400",
                },
                {
                    text: "Python",
                    color: "text-yellow-600 dark:text-yellow-400",
                },
                { text: ".NET", color: "text-purple-600 dark:text-purple-400" },
            ];

            let typeTimeout: ReturnType<typeof setTimeout>;
            let wordIndex = 0;
            let charIndex = words[0].text.length;
            let isDeleting = false;

            function type(textElement: HTMLElement) {
                const currentWord = words[wordIndex];

                if (!textElement) return;

                textElement.className = `font-bold ${currentWord.color}`;

                if (isDeleting) {
                    textElement.textContent = currentWord.text.substring(
                        0,
                        charIndex - 1,
                    );
                    charIndex--;
                } else {
                    textElement.textContent = currentWord.text.substring(
                        0,
                        charIndex + 1,
                    );
                    charIndex++;
                }

                let typeSpeed = isDeleting ? 50 : 100;

                if (!isDeleting && charIndex >= currentWord.text.length) {
                    charIndex = currentWord.text.length;
                    typeSpeed = 2000;
                    isDeleting = true;
                } else if (isDeleting && charIndex <= 0) {
                    charIndex = 0;
                    isDeleting = false;
                    wordIndex = (wordIndex + 1) % words.length;
                    typeSpeed = 500;
                }

                typeTimeout = setTimeout(() => type(textElement), typeSpeed);
            }

            function initTypewriter() {
                clearTimeout(typeTimeout);
                const textElement = document.getElementById("typewriter-text");
                const cursorElement = document.getElementById("typewriter-cursor");
                if (!textElement) return;

                wordIndex = 0;
                charIndex = words[0].text.length;
                isDeleting = true;
                textElement.className = `font-bold ${words[0].color}`;
                textElement.textContent = words[0].text;

                const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                if (reduceMotion) {
                    cursorElement?.classList.add("hidden");
                    return;
                }
                cursorElement?.classList.remove("hidden");
                typeTimeout = setTimeout(() => type(textElement), 2000);
            }

            document.addEventListener("astro:before-swap", () => clearTimeout(typeTimeout));
            document.addEventListener("astro:page-load", initTypewriter);
        </script>

        <style>
            @keyframes blink {
                0%,
                100% {
                    opacity: 1;
                }
                50% {
                    opacity: 0;
                }
            }
            .animate-blink {
                animation: blink 1s infinite;
            }
            #typewriter-text::before {
                content: "\200b";
            }
        </style>

        <div
            class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 justify-center items-center pt-6 sm:pt-8 w-full sm:w-auto animate-fade-in-up"
            style="animation-delay: 0.4s"
        >
            <a
                href="#proyectos"
                class="w-full sm:w-auto min-w-[180px] min-h-[48px] px-7 py-3 bg-violet-600 hover:bg-violet-700 text-white font-semibold rounded-full transition-all hover:scale-[1.03] shadow-lg shadow-violet-600/25 flex justify-center items-center"
            >
                {t("hero.viewProjects")}
            </a>
            <a
                href="#contacto"
                class="w-full sm:w-auto min-w-[180px] min-h-[48px] px-7 py-3 glass-card hover:border-violet-500/50 rounded-full font-semibold transition-all text-slate-700 dark:text-slate-200 flex justify-center items-center"
            >
                {t("hero.contactMe")}
            </a>
            <a
                href={cvHref}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] px-5 py-2.5 rounded-full text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-300 hover:bg-slate-200/60 dark:hover:bg-slate-800/60 font-medium transition-all flex items-center justify-center gap-2 group"
                aria-label={t("hero.cv.aria")}
            >
                <Icon name="mdi:download-outline" class="w-4.5 h-4.5" aria-hidden="true" />
                {t("nav.cv")}
            </a>
        </div>
    </div>
</section>
