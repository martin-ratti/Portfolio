---
import { projects } from "../data/projects";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";
import ProjectCard from "./ProjectCard.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);

const webCount = projects.filter((p) =>
    p.tags.some((tag) => ["Astro", "React", "Blazor", "JSP"].includes(tag)),
).length;
const desktopCount = projects.filter((p) =>
    p.tags.some((tag) => ["WinForms", "Python"].includes(tag)),
).length;
const mobileCount = projects.filter((p) =>
    p.tags.some((tag) => ["Android", "Kotlin", "Jetpack Compose"].includes(tag)),
).length;

const platformOptions = [
    { id: "all", label: t("projects.platform.all"), count: projects.length },
    { id: "web", label: t("projects.platform.web"), count: webCount },
    { id: "desktop", label: t("projects.platform.desktop"), count: desktopCount },
    { id: "mobile", label: t("projects.platform.mobile"), count: mobileCount },
] as const;
---

<section id="proyectos" class="py-16 sm:py-24 px-4 max-w-6xl mx-auto scroll-mt-16">
    <!-- Editorial Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 mb-6 sm:mb-8">
        <div>
            <div class="inline-flex items-center gap-3 mb-2 sm:mb-3">
                <span class="font-mono text-xs uppercase tracking-[0.22em] text-violet-600 dark:text-violet-400 font-semibold">
                    {t("projects.eyebrow")}
                </span>
                <span class="h-px w-10 bg-linear-to-r from-violet-500/60 to-transparent" aria-hidden="true"></span>
            </div>
            <h2 class="text-[1.75rem] sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-[1.15] sm:leading-[1.12]">
                {t("projects.headline.prefix")}{" "}
                <span class="text-gradient">{t("projects.headline.highlight")}</span>
            </h2>
        </div>

        <p class="inline-flex items-center gap-2 self-start md:self-auto px-3.5 py-2 rounded-2xl sm:rounded-full bg-white/75 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-medium text-slate-600 dark:text-slate-300 shadow-sm max-w-sm">
            <Icon name="mdi:folder-multiple-outline" class="w-4 h-4 text-violet-500 shrink-0" aria-hidden="true" />
            <span>{t("projects.subtitle")}</span>
        </p>
    </div>

    <!-- Platform Filter Pills -->
    <div
        id="projects-platform-bar"
        role="group"
        aria-label={t("projects.platform.aria")}
        class="mb-7 sm:mb-9 flex flex-wrap items-center gap-2"
    >
        {
            platformOptions.map((opt, idx) => (
                <button
                    type="button"
                    data-platform={opt.id}
                    aria-pressed={idx === 0 ? "true" : "false"}
                    class={`platform-filter-btn min-h-[38px] inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold border transition-colors cursor-pointer ${idx === 0 ? "is-platform-active bg-violet-600 text-white border-violet-600 shadow-sm shadow-violet-600/25" : "bg-white/75 dark:bg-slate-900/60 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-800 hover:border-violet-500/50 hover:text-violet-600 dark:hover:text-violet-300"}`}
                >
                    <span>{opt.label}</span>
                    <span class={`platform-count font-mono text-[11px] px-1.5 py-0.5 rounded-full ${idx === 0 ? "bg-white/20 text-white" : "bg-slate-200/80 dark:bg-slate-800 text-slate-600 dark:text-slate-400"}`}>
                        {opt.count}
                    </span>
                </button>
            ))
        }
    </div>

    <div
        id="projects-filter-banner"
        role="status"
        aria-live="polite"
        data-prefix={t("projects.filter.active")}
        data-singular={t("projects.filter.countSingular")}
        data-plural={t("projects.filter.countPlural")}
        class="hidden mb-8 sm:mb-10 mx-auto max-w-2xl glass-card rounded-2xl sm:rounded-full px-4 sm:px-5 py-2.5 flex-wrap items-center justify-between sm:justify-center gap-3 text-xs sm:text-sm border border-violet-500/35 shadow-md shadow-violet-500/10"
    >
        <span id="projects-filter-text" class="font-medium text-slate-700 dark:text-slate-200"></span>
        <button
            type="button"
            id="projects-filter-clear"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 min-h-[36px] rounded-full text-xs font-semibold bg-violet-600 hover:bg-violet-700 text-white transition-colors cursor-pointer"
        >
            <Icon name="mdi:close" class="w-3.5 h-3.5" aria-hidden="true" />
            <span>{t("projects.filter.clear")}</span>
        </button>
    </div>

    <div id="featured-projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {
            featuredProjects.map((project, index) => (
                <ProjectCard
                    project={project}
                    index={index}
                    featured={true}
                    baseDelay={0}
                />
            ))
        }
    </div>

    <div id="other-projects-heading" class="mt-14 sm:mt-16 mb-7 sm:mb-9">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 font-semibold mb-1.5">
            {t("projects.otherEyebrow")}
        </p>
        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
            {t("projects.other")}
        </h3>
    </div>

    <div id="other-projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {
            otherProjects.map((project, index) => (
                <ProjectCard
                    project={project}
                    index={index}
                    featured={false}
                    baseDelay={featuredProjects.length * 0.1}
                />
            ))
        }
    </div>
</section>

<style is:global>
    .project-card.is-match {
        opacity: 1;
        filter: grayscale(0) drop-shadow(0 0 14px rgba(139, 92, 246, 0.35));
        transform: translateY(-4px);
        border-color: rgba(139, 92, 246, 0.85);
        z-index: 10;
    }

    @media (min-width: 768px) {
        .project-card.is-match {
            transform: scale(1.02);
        }
    }

    .project-card.is-dimmed {
        opacity: 0.32;
        filter: grayscale(65%);
        transform: scale(0.98);
        border-color: transparent;
        box-shadow: none;
        z-index: 0;
    }

    @keyframes success-flash {
        0% {
            box-shadow: 0 0 0 0 rgba(139, 92, 246, 0);
        }
        30% {
            box-shadow: 0 0 24px 8px rgba(139, 92, 246, 0.45);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(139, 92, 246, 0);
        }
    }

    .project-card.animate-success-flash {
        animation: success-flash 1.1s ease-out forwards;
    }
</style>

<script>
    let projectsFilterController: AbortController | null = null;

    function cleanupProjectsFilter() {
        if (projectsFilterController) {
            projectsFilterController.abort();
            projectsFilterController = null;
        }
    }

    function initProjectsFilter() {
        cleanupProjectsFilter();
        projectsFilterController = new AbortController();
        const { signal } = projectsFilterController;

        const banner = document.getElementById("projects-filter-banner");
        const bannerText = document.getElementById("projects-filter-text");
        const clearBtn = document.getElementById("projects-filter-clear");
        const platformButtons = document.querySelectorAll<HTMLButtonElement>(".platform-filter-btn");
        const featuredGrid = document.getElementById("featured-projects-grid");
        const otherHeading = document.getElementById("other-projects-heading");
        const otherGrid = document.getElementById("other-projects-grid");

        let activePlatform = "all";
        let hasActiveSkillFilter = false;

        const ACTIVE_BTN_CLASSES = [
            "is-platform-active",
            "bg-violet-600",
            "text-white",
            "border-violet-600",
            "shadow-sm",
            "shadow-violet-600/25",
        ];
        const INACTIVE_BTN_CLASSES = [
            "bg-white/75",
            "dark:bg-slate-900/60",
            "text-slate-700",
            "dark:text-slate-300",
            "border-slate-200",
            "dark:border-slate-800",
            "hover:border-violet-500/50",
            "hover:text-violet-600",
            "dark:hover:text-violet-300",
        ];

        function applyPlatformFilter(platform: string) {
            activePlatform = platform;

            platformButtons.forEach((btn) => {
                const isSelected = btn.dataset.platform === platform;
                btn.setAttribute("aria-pressed", isSelected ? "true" : "false");
                const countSpan = btn.querySelector(".platform-count");

                if (isSelected) {
                    btn.classList.add(...ACTIVE_BTN_CLASSES);
                    btn.classList.remove(...INACTIVE_BTN_CLASSES);
                    countSpan?.classList.add("bg-white/20", "text-white");
                    countSpan?.classList.remove(
                        "bg-slate-200/80",
                        "dark:bg-slate-800",
                        "text-slate-600",
                        "dark:text-slate-400",
                    );
                } else {
                    btn.classList.remove(...ACTIVE_BTN_CLASSES);
                    btn.classList.add(...INACTIVE_BTN_CLASSES);
                    countSpan?.classList.remove("bg-white/20", "text-white");
                    countSpan?.classList.add(
                        "bg-slate-200/80",
                        "dark:bg-slate-800",
                        "text-slate-600",
                        "dark:text-slate-400",
                    );
                }
            });

            const syncGridVisibility = (grid: HTMLElement | null): number => {
                if (!grid) return 0;
                let visibleCount = 0;
                grid.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
                    const cardPlatforms = JSON.parse(
                        card.getAttribute("data-platforms") || "[]",
                    ) as string[];
                    const matches = platform === "all" || cardPlatforms.includes(platform);
                    card.classList.toggle("hidden", !matches);
                    if (matches) visibleCount++;
                });
                grid.classList.toggle("hidden", visibleCount === 0);
                return visibleCount;
            };

            syncGridVisibility(featuredGrid);
            const otherVisible = syncGridVisibility(otherGrid);
            otherHeading?.classList.toggle("hidden", otherVisible === 0);
        }

        platformButtons.forEach((btn) => {
            btn.addEventListener(
                "click",
                () => {
                    const targetPlatform = btn.dataset.platform || "all";
                    if (hasActiveSkillFilter) {
                        hasActiveSkillFilter = false;
                        window.dispatchEvent(
                            new CustomEvent("filter-projects", {
                                detail: { skill: null },
                            }),
                        );
                    }
                    applyPlatformFilter(targetPlatform);
                },
                { signal },
            );
        });

        clearBtn?.addEventListener(
            "click",
            () => {
                window.dispatchEvent(
                    new CustomEvent("filter-projects", {
                        detail: { skill: null },
                    }),
                );
            },
            { signal },
        );

        window.addEventListener(
            "filter-projects",
            (e: Event) => {
                const customEvent = e as CustomEvent;
                const selectedSkill = customEvent.detail?.skill;
                const cards = document.querySelectorAll(".project-card");

                if (!selectedSkill) {
                    hasActiveSkillFilter = false;
                    cards.forEach((card) => {
                        card.classList.remove("is-match", "is-dimmed", "animate-success-flash");
                    });
                    if (banner) {
                        banner.classList.add("hidden");
                        banner.classList.remove("flex");
                    }
                    if (bannerText) bannerText.textContent = "";
                    return;
                }

                hasActiveSkillFilter = true;
                if (activePlatform !== "all") {
                    applyPlatformFilter("all");
                }

                let firstMatch: HTMLElement | null = null;
                let matchCount = 0;

                cards.forEach((card) => {
                    const el = card as HTMLElement;
                    const techs = JSON.parse(el.getAttribute("data-techs") || "[]");
                    el.classList.remove("animate-success-flash");

                    if (techs.includes(selectedSkill)) {
                        el.classList.add("is-match");
                        el.classList.remove("is-dimmed");
                        matchCount++;
                        if (!firstMatch) firstMatch = el;
                    } else {
                        el.classList.add("is-dimmed");
                        el.classList.remove("is-match");
                    }
                });

                if (banner && bannerText) {
                    const prefix = banner.dataset.prefix || "Filtrando por";
                    const noun =
                        matchCount === 1
                            ? banner.dataset.singular || "proyecto"
                            : banner.dataset.plural || "proyectos";
                    bannerText.textContent = `${prefix} ${selectedSkill} (${matchCount} ${noun})`;
                    banner.classList.remove("hidden");
                    banner.classList.add("flex");
                }

                if (firstMatch) {
                    const matchEl = firstMatch as HTMLElement;
                    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                    setTimeout(() => {
                        matchEl.scrollIntoView({
                            behavior: reduceMotion ? "auto" : "smooth",
                            block: "center",
                        });
                        if (!reduceMotion) {
                            setTimeout(() => {
                                matchEl.classList.add("animate-success-flash");
                            }, 450);
                        }
                    }, 100);
                }
            },
            { signal },
        );
    }

    document.addEventListener("astro:before-swap", cleanupProjectsFilter);
    document.addEventListener("astro:page-load", initProjectsFilter);
</script>
