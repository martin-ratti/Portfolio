---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contacto" class="py-16 sm:py-24 px-4 max-w-6xl mx-auto scroll-mt-16">
    <!-- Editorial Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-12">
        <div>
            <div class="inline-flex items-center gap-3 mb-2 sm:mb-3">
                <span class="font-mono text-xs uppercase tracking-[0.22em] text-fuchsia-600 dark:text-fuchsia-400 font-semibold">
                    {t("contact.eyebrow")}
                </span>
                <span class="h-px w-10 bg-linear-to-r from-fuchsia-500/60 to-transparent" aria-hidden="true"></span>
            </div>
            <h2
                id="contact-heading"
                class="text-[1.75rem] sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-[1.15] sm:leading-[1.12]"
            >
                {t("contact.headline.prefix")}{" "}
                <span class="text-gradient">{t("contact.headline.highlight")}</span>
            </h2>
        </div>

        <div class="inline-flex items-center gap-2 self-start md:self-auto px-3.5 py-2 rounded-full bg-white/75 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-medium text-slate-600 dark:text-slate-300 shadow-sm shrink-0">
            <Icon name="mdi:clock-fast" class="w-4 h-4 text-emerald-500 shrink-0" aria-hidden="true" />
            <span>{t("contact.responseTime")}</span>
        </div>
    </div>

    <!-- Asymmetric 12-Col Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <!-- Left Column: Intro + Direct Channels -->
        <div class="lg:col-span-5 flex flex-col gap-5 contact-reveal">
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed">
                {t("contact.desc")}
            </p>

            <div class="flex flex-col gap-3">
                <!-- Email Card (obfuscated in static HTML to reduce scraping) -->
                <div
                    id="email-channel-card"
                    data-u="01ittarnitram"
                    data-d="moc.liamg"
                    class="glass-card rounded-2xl p-4 border border-slate-200/90 dark:border-slate-800/90 flex items-center justify-between gap-3 shadow-md shadow-slate-200/40 dark:shadow-none"
                >
                    <button
                        type="button"
                        id="reveal-email-btn"
                        aria-label={t("contact.email.revealAria")}
                        class="flex items-center gap-3 min-w-0 flex-1 text-left group cursor-pointer"
                    >
                        <div class="w-10 h-10 rounded-xl bg-violet-500/10 border border-violet-500/25 flex items-center justify-center shrink-0 text-violet-600 dark:text-violet-300">
                            <Icon name="mdi:email-outline" class="w-5 h-5" aria-hidden="true" />
                        </div>
                        <div class="min-w-0">
                            <span class="block text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                Email
                            </span>
                            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900 dark:text-white truncate group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors">
                                <span id="email-display" class="truncate">{t("contact.email.protected")}</span>
                                <Icon name="mdi:eye-outline" class="w-3.5 h-3.5 text-slate-400 shrink-0" aria-hidden="true" />
                            </span>
                        </div>
                    </button>

                    <a
                        id="email-direct-link"
                        href="#"
                        class="hidden items-center gap-3 min-w-0 flex-1 group"
                    >
                        <div class="w-10 h-10 rounded-xl bg-violet-500/10 border border-violet-500/25 flex items-center justify-center shrink-0 text-violet-600 dark:text-violet-300">
                            <Icon name="mdi:email-outline" class="w-5 h-5" aria-hidden="true" />
                        </div>
                        <div class="min-w-0">
                            <span class="block text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                Email
                            </span>
                            <span id="email-revealed-text" class="block text-sm font-semibold text-slate-900 dark:text-white truncate group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors"></span>
                        </div>
                    </a>

                    <button
                        id="copy-email-btn"
                        type="button"
                        aria-label={t("contact.email.copyAria")}
                        title={t("contact.email.copy")}
                        data-label-copy={t("contact.email.copy")}
                        data-label-copied={t("contact.email.copied")}
                        data-label-error={t("contact.email.copyError")}
                        class="inline-flex items-center justify-center gap-1.5 min-h-[40px] px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/70 hover:border-violet-500/50 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:text-violet-600 dark:hover:text-violet-300 transition-colors shrink-0 cursor-pointer"
                    >
                        <Icon id="copy-email-icon" name="mdi:content-copy" class="w-4 h-4 shrink-0" aria-hidden="true" />
                        <Icon id="copy-email-check" name="mdi:check" class="hidden w-4 h-4 text-emerald-500 shrink-0" aria-hidden="true" />
                        <span id="copy-email-label">{t("contact.email.copy")}</span>
                    </button>
                    <span id="copy-email-status" class="sr-only" role="status" aria-live="polite"></span>
                </div>

                <!-- LinkedIn Card -->
                <a
                    href="https://www.linkedin.com/in/martin-ratti-dev/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="glass-card rounded-2xl p-4 min-h-[64px] border border-slate-200/90 dark:border-slate-800/90 hover:border-[#0A66C2]/50 flex items-center justify-between gap-3 group shadow-md shadow-slate-200/40 dark:shadow-none"
                >
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-[#0A66C2]/10 border border-[#0A66C2]/25 flex items-center justify-center shrink-0 text-[#0A66C2] dark:text-[#38bdf8]">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <span class="block text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                LinkedIn
                            </span>
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white truncate group-hover:text-[#0A66C2] dark:group-hover:text-[#38bdf8] transition-colors">
                                /in/martin-ratti-dev
                            </span>
                        </div>
                    </div>
                    <Icon name="mdi:open-in-new" class="w-4 h-4 text-slate-400 group-hover:text-[#0A66C2] dark:group-hover:text-[#38bdf8] shrink-0 transition-colors" aria-hidden="true" />
                </a>

                <!-- GitHub Card -->
                <a
                    href="https://github.com/martin-ratti"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="glass-card rounded-2xl p-4 min-h-[64px] border border-slate-200/90 dark:border-slate-800/90 hover:border-fuchsia-500/50 flex items-center justify-between gap-3 group shadow-md shadow-slate-200/40 dark:shadow-none"
                >
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-fuchsia-500/10 border border-fuchsia-500/25 flex items-center justify-center shrink-0 text-slate-800 dark:text-slate-200">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <span class="block text-[11px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                GitHub
                            </span>
                            <span class="block text-sm font-semibold text-slate-900 dark:text-white truncate group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-400 transition-colors">
                                @martin-ratti
                            </span>
                        </div>
                    </div>
                    <Icon name="mdi:open-in-new" class="w-4 h-4 text-slate-400 group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-400 shrink-0 transition-colors" aria-hidden="true" />
                </a>
            </div>
        </div>

        <!-- Right Column: Single Clean Form Card -->
        <div class="lg:col-span-7 contact-reveal">
            <div class="glass-card rounded-2xl sm:rounded-3xl p-5 sm:p-8 relative overflow-hidden shadow-xl shadow-slate-200/50 dark:shadow-none">
                <div
                    class="absolute -right-14 -top-14 w-56 h-56 bg-violet-500/10 dark:bg-violet-500/15 rounded-full blur-3xl pointer-events-none"
                    aria-hidden="true"
                >
                </div>

                <div id="form-container" class="w-full relative z-10">
                    <form
                        id="contact-form"
                        action="https://api.web3forms.com/submit"
                        method="POST"
                        aria-labelledby="contact-heading"
                        class="flex flex-col gap-4 sm:gap-5"
                    >
                        <input
                            type="hidden"
                            name="access_key"
                            value="e3ffd7ce-28bb-40ba-a80d-dddc59051a14"
                        />
                        <input
                            type="checkbox"
                            name="botcheck"
                            tabindex="-1"
                            aria-hidden="true"
                            class="hidden"
                        />

                        <!-- Name Field -->
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="contact-name"
                                class="text-sm font-semibold text-slate-800 dark:text-slate-200"
                            >
                                {t("contact.form.name")}
                                <span class="text-violet-600 dark:text-violet-400" aria-hidden="true">*</span>
                            </label>
                            <input
                                type="text"
                                id="contact-name"
                                name="name"
                                autocomplete="name"
                                enterkeyhint="next"
                                required
                                minlength="2"
                                placeholder={t("contact.form.namePlaceholder")}
                                aria-invalid="false"
                                data-error="contact-name-error"
                                class="contact-input w-full min-h-[48px] bg-white/90 dark:bg-slate-900/70 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-3 text-base text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500/25 transition-colors"
                            />
                            <p id="contact-name-error" class="contact-error-msg items-center gap-1.5 text-xs font-medium text-red-600 dark:text-red-400 mt-0.5">
                                <Icon name="mdi:alert-circle-outline" class="w-4 h-4 shrink-0" aria-hidden="true" />
                                <span>{t("contact.form.nameError")}</span>
                            </p>
                        </div>

                        <!-- Email Field -->
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="contact-email"
                                class="text-sm font-semibold text-slate-800 dark:text-slate-200"
                            >
                                {t("contact.form.email")}
                                <span class="text-violet-600 dark:text-violet-400" aria-hidden="true">*</span>
                            </label>
                            <input
                                type="email"
                                id="contact-email"
                                name="email"
                                autocomplete="email"
                                inputmode="email"
                                autocorrect="off"
                                autocapitalize="none"
                                spellcheck="false"
                                enterkeyhint="next"
                                required
                                placeholder={t("contact.form.emailPlaceholder")}
                                aria-invalid="false"
                                data-error="contact-email-error"
                                class="contact-input w-full min-h-[48px] bg-white/90 dark:bg-slate-900/70 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-3 text-base text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500/25 transition-colors"
                            />
                            <p id="contact-email-error" class="contact-error-msg items-center gap-1.5 text-xs font-medium text-red-600 dark:text-red-400 mt-0.5">
                                <Icon name="mdi:alert-circle-outline" class="w-4 h-4 shrink-0" aria-hidden="true" />
                                <span>{t("contact.form.emailError")}</span>
                            </p>
                        </div>

                        <!-- Message Field -->
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="contact-message"
                                class="text-sm font-semibold text-slate-800 dark:text-slate-200"
                            >
                                {t("contact.form.message")}
                                <span class="text-violet-600 dark:text-violet-400" aria-hidden="true">*</span>
                            </label>
                            <textarea
                                id="contact-message"
                                name="message"
                                rows="4"
                                required
                                minlength="10"
                                placeholder={t("contact.form.messagePlaceholder")}
                                aria-invalid="false"
                                data-error="contact-message-error"
                                class="contact-input auto-fit-textarea w-full bg-white/90 dark:bg-slate-900/70 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-3 text-base text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-500/25 transition-colors resize-none"
                            ></textarea>
                            <p id="contact-message-error" class="contact-error-msg items-center gap-1.5 text-xs font-medium text-red-600 dark:text-red-400 mt-0.5">
                                <Icon name="mdi:alert-circle-outline" class="w-4 h-4 shrink-0" aria-hidden="true" />
                                <span>{t("contact.form.messageError")}</span>
                            </p>
                        </div>

                        <button
                            type="submit"
                            id="contact-submit-btn"
                            class="mt-1 min-h-[48px] w-full bg-violet-600 hover:bg-violet-700 text-white font-semibold py-3 px-5 rounded-xl transition-all flex items-center justify-center gap-2 group cursor-pointer disabled:opacity-70 disabled:cursor-not-allowed shadow-lg shadow-violet-600/20"
                        >
                            <span id="submit-text" data-sending={t("contact.form.sending")}>{t("contact.form.send")}</span>
                            <Icon name="mdi:send-outline" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" aria-hidden="true" />
                        </button>

                        <!-- Declarative Error Banner -->
                        <div
                            id="form-result"
                            role="status"
                            aria-live="polite"
                            aria-atomic="true"
                            class="hidden animate-fade-in"
                            data-error={t("contact.form.error")}
                            data-timeout-error={t("contact.form.timeoutError")}
                        >
                            <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-xl border border-red-500/25 bg-red-500/10 text-red-600 dark:text-red-400">
                                <div class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center bg-red-500/20">
                                    <Icon name="mdi:alert-circle-outline" class="w-5 h-5" aria-hidden="true" />
                                </div>
                                <p id="result-message" class="text-sm font-medium"></p>
                            </div>
                        </div>
                    </form>

                    <!-- Single Polite Validation Announcer -->
                    <div id="contact-field-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

                    <!-- Success State -->
                    <div
                        id="success-state"
                        role="status"
                        tabindex="-1"
                        class="hidden flex-col items-center justify-center text-center p-5 sm:p-10 animate-fade-in rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 min-h-[340px] sm:min-h-[420px] focus:outline-none focus:ring-2 focus:ring-violet-500"
                    >
                        <div class="relative mb-6 sm:mb-8 flex items-center justify-center">
                            <svg class="w-20 h-20 sm:w-24 sm:h-24" viewBox="0 0 52 52" aria-hidden="true">
                                <circle class="animate-circle text-green-500 dark:text-green-400" cx="26" cy="26" r="25" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="160" stroke-dashoffset="160" />
                                <path class="animate-check text-green-500 dark:text-green-400" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="48" stroke-dashoffset="48" />
                            </svg>
                            <div class="absolute inset-0 bg-green-500/10 rounded-full blur-2xl" aria-hidden="true"></div>
                        </div>

                        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-3 sm:mb-4">
                            {t("contact.form.success")}
                        </h3>
                        <p class="text-sm sm:text-lg text-slate-600 dark:text-slate-300 max-w-sm mb-8 leading-relaxed">
                            {t("contact.form.success2")}
                        </p>

                        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto">
                            <button
                                id="reset-form"
                                type="button"
                                class="min-h-[44px] px-6 py-2.5 bg-violet-600 hover:bg-violet-700 text-white font-semibold rounded-xl transition-all shadow-lg shadow-violet-500/25 hover:scale-[1.02] active:scale-95 cursor-pointer"
                            >
                                {t("contact.form.reset")}
                            </button>
                            <a
                                href="#proyectos"
                                class="min-h-[44px] inline-flex items-center justify-center px-6 py-2.5 glass-card border border-slate-200 dark:border-slate-700 font-semibold rounded-xl hover:bg-white dark:hover:bg-slate-800 transition text-slate-700 dark:text-slate-300 hover:scale-[1.02] active:scale-95"
                            >
                                {t("contact.form.back")}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-input {
        font-size: max(1rem, 1em);
        --autofill-ring-color: #7c3aed;
    }

    :global(.dark) .contact-input {
        --autofill-ring-color: #a78bfa;
    }

    .contact-error-msg {
        display: none;
    }

    .contact-input:user-invalid {
        border-color: #dc2626;
    }

    :global(.dark) .contact-input:user-invalid {
        border-color: #f87171;
    }

    .contact-input:user-invalid + .contact-error-msg {
        display: flex;
    }

    .contact-input:user-valid {
        border-color: #059669;
    }

    :global(.dark) .contact-input:user-valid {
        border-color: #34d399;
    }

    .contact-input:is(:autofill, :-webkit-autofill) {
        box-shadow: inset 0 0 0 2px var(--autofill-ring-color);
        border-color: var(--autofill-ring-color);
    }

    @keyframes contactReveal {
        from {
            opacity: 0;
            translate: 0 18px;
        }
        to {
            opacity: 1;
            translate: 0 0;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        @supports ((animation-timeline: view()) and (animation-range: entry)) {
            .contact-reveal {
                animation: contactReveal linear both;
                animation-timeline: view();
                animation-range: entry 0% entry 20%;
            }
        }
    }
</style>

<script>
    let contactAbortController: AbortController | null = null;
    let fetchAbortController: AbortController | null = null;
    let resultHideTimer: ReturnType<typeof setTimeout> | null = null;
    let copyEmailTimer: ReturnType<typeof setTimeout> | null = null;
    let announceTimer: ReturnType<typeof setTimeout> | null = null;

    function cleanupContactForm() {
        if (contactAbortController) {
            contactAbortController.abort();
            contactAbortController = null;
        }
        if (fetchAbortController) {
            fetchAbortController.abort();
            fetchAbortController = null;
        }
        if (resultHideTimer !== null) {
            clearTimeout(resultHideTimer);
            resultHideTimer = null;
        }
        if (copyEmailTimer !== null) {
            clearTimeout(copyEmailTimer);
            copyEmailTimer = null;
        }
        if (announceTimer !== null) {
            clearTimeout(announceTimer);
            announceTimer = null;
        }
    }

    function copyTextFallback(text: string): boolean {
        const helper = document.createElement("textarea");
        helper.value = text;
        helper.setAttribute("readonly", "");
        helper.style.cssText = "position:fixed;opacity:0;pointer-events:none;left:-9999px";
        document.body.appendChild(helper);
        helper.select();
        let ok = false;
        try {
            ok = document.execCommand("copy");
        } catch {
            ok = false;
        }
        document.body.removeChild(helper);
        return ok;
    }

    function decodeEmail(card: HTMLElement | null): string {
        const userPart = card?.dataset.u || "";
        const domainPart = card?.dataset.d || "";
        if (!userPart || !domainPart) return "";
        const reverse = (s: string) => s.split("").reverse().join("");
        return `${reverse(userPart)}@${reverse(domainPart)}`;
    }

    function initContactForm() {
        cleanupContactForm();
        contactAbortController = new AbortController();
        const { signal } = contactAbortController;

        // Obfuscated Email Reveal & Copy Button with fallback & failure feedback
        const emailCard = document.getElementById("email-channel-card");
        const revealEmailBtn = document.getElementById("reveal-email-btn");
        const emailDirectLink = document.getElementById("email-direct-link") as HTMLAnchorElement | null;
        const emailRevealedText = document.getElementById("email-revealed-text");

        const copyEmailBtn = document.getElementById("copy-email-btn");
        const copyEmailIcon = document.getElementById("copy-email-icon");
        const copyEmailCheck = document.getElementById("copy-email-check");
        const copyEmailLabel = document.getElementById("copy-email-label");
        const copyEmailStatus = document.getElementById("copy-email-status");

        const revealEmail = (): string => {
            const email = decodeEmail(emailCard);
            if (!email) return "";
            if (emailDirectLink && emailRevealedText) {
                emailDirectLink.href = `mailto:${email}`;
                emailRevealedText.textContent = email;
                revealEmailBtn?.classList.add("hidden");
                emailDirectLink.classList.remove("hidden");
                emailDirectLink.classList.add("flex");
            }
            return email;
        };

        revealEmailBtn?.addEventListener(
            "click",
            () => {
                if (revealEmail()) {
                    emailDirectLink?.focus();
                }
            },
            { signal },
        );

        copyEmailBtn?.addEventListener(
            "click",
            async () => {
                const email = revealEmail() || decodeEmail(emailCard);
                const labelCopy = copyEmailBtn.dataset.labelCopy || "Copiar email";
                const labelCopied = copyEmailBtn.dataset.labelCopied || "¡Copiado!";
                const labelError = copyEmailBtn.dataset.labelError || "No se pudo copiar";

                let copied = false;
                if (email) {
                    try {
                        if (navigator.clipboard?.writeText) {
                            await navigator.clipboard.writeText(email);
                            copied = true;
                        }
                    } catch {
                        copied = false;
                    }

                    if (!copied) {
                        copied = copyTextFallback(email);
                    }
                }

                if (copyEmailTimer !== null) clearTimeout(copyEmailTimer);

                if (copied) {
                    copyEmailIcon?.classList.add("hidden");
                    copyEmailCheck?.classList.remove("hidden");
                    if (copyEmailLabel) copyEmailLabel.textContent = labelCopied;
                    if (copyEmailStatus) copyEmailStatus.textContent = labelCopied;
                } else {
                    copyEmailIcon?.classList.remove("hidden");
                    copyEmailCheck?.classList.add("hidden");
                    if (copyEmailLabel) copyEmailLabel.textContent = labelError;
                    if (copyEmailStatus) copyEmailStatus.textContent = labelError;
                }

                copyEmailTimer = setTimeout(() => {
                    copyEmailIcon?.classList.remove("hidden");
                    copyEmailCheck?.classList.add("hidden");
                    if (copyEmailLabel) copyEmailLabel.textContent = labelCopy;
                    if (copyEmailStatus) copyEmailStatus.textContent = "";
                    copyEmailTimer = null;
                }, 2200);
            },
            { signal },
        );

        const form = document.getElementById("contact-form") as HTMLFormElement | null;
        const result = document.getElementById("form-result");
        const resultMessage = document.getElementById("result-message");
        const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;
        const submitText = document.getElementById("submit-text");
        const announcer = document.getElementById("contact-field-announcer");

        if (!form || !result || !resultMessage || !submitBtn || !submitText) return;

        // Auto-resize textarea fallback when field-sizing: content is unsupported
        const messageTextarea = document.getElementById("contact-message") as HTMLTextAreaElement | null;
        const supportsFieldSizing =
            typeof CSS !== "undefined" &&
            typeof CSS.supports === "function" &&
            CSS.supports("field-sizing", "content");

        if (messageTextarea && !supportsFieldSizing) {
            messageTextarea.style.overflow = "hidden";
            const resizeTextarea = () => {
                messageTextarea.style.height = "auto";
                messageTextarea.style.height = `${messageTextarea.scrollHeight}px`;
            };
            messageTextarea.addEventListener("input", resizeTextarea, { signal });
            if (messageTextarea.value) resizeTextarea();
        }

        // ARIA sync for :user-invalid without premature errors
        const flagged = new WeakSet<Element>();
        const announced = new WeakSet<Element>();
        let announcedField: Element | null = null;

        const linkError = (el: HTMLElement, shown: boolean) => {
            const errorId = el.dataset.error;
            if (!errorId) return;
            const ids = (el.getAttribute("aria-describedby") || "")
                .split(/\s+/)
                .filter((id) => id && id !== errorId);
            if (shown) ids.push(errorId);
            if (ids.length > 0) el.setAttribute("aria-describedby", ids.join(" "));
            else el.removeAttribute("aria-describedby");
        };

        const announceError = (el: HTMLInputElement | HTMLTextAreaElement) => {
            const errorId = el.dataset.error;
            if (!errorId || !announcer) return;
            const errorEl = document.getElementById(errorId);
            if (!errorEl) return;
            const labelText = el.labels?.[0]?.textContent?.replace("*", "").trim();
            const prefix = labelText ? `${labelText}: ` : "";
            const text = (errorEl.textContent || "").replace(/\s+/g, " ").trim();

            if (announceTimer !== null) clearTimeout(announceTimer);
            announcer.textContent = "";
            announcedField = el;
            announceTimer = setTimeout(() => {
                announcer.textContent = `${prefix}${text}`;
                announceTimer = null;
            }, 400);
        };

        const syncAria = (target: EventTarget | null, shouldAnnounce = false) => {
            if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) {
                return;
            }
            let invalid = false;
            try {
                invalid = target.matches(":user-invalid");
            } catch {
                invalid = !target.validity.valid;
            }

            if (invalid) {
                if (shouldAnnounce && !announced.has(target)) {
                    announceError(target);
                    announced.add(target);
                }
                target.setAttribute("aria-invalid", "true");
                linkError(target, true);
                flagged.add(target);
            } else if (flagged.has(target) || target.getAttribute("aria-invalid") !== "true") {
                target.setAttribute("aria-invalid", "false");
                linkError(target, false);
                flagged.delete(target);
                announced.delete(target);
                if (announcedField === target && announcer) {
                    if (announceTimer !== null) {
                        clearTimeout(announceTimer);
                        announceTimer = null;
                    }
                    announcer.textContent = "";
                }
            }
        };

        form.addEventListener("blur", (e) => syncAria(e.target, true), { capture: true, signal });
        form.addEventListener("input", (e) => {
            if (e.target instanceof HTMLElement && e.target.hasAttribute("aria-invalid")) {
                syncAria(e.target, false);
            }
        }, { signal });
        form.addEventListener(
            "invalid",
            (e) => {
                if (e.target instanceof Element) announced.add(e.target);
                syncAria(e.target, false);
            },
            { capture: true, signal },
        );
        form.addEventListener(
            "reset",
            () => {
                setTimeout(() => {
                    form.querySelectorAll("input, textarea").forEach((el) => {
                        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
                            el.setAttribute("aria-invalid", "false");
                            linkError(el, false);
                            flagged.delete(el);
                            announced.delete(el);
                        }
                    });
                });
            },
            { signal },
        );

        const originalText = submitText.textContent || "";
        const sendingText = submitText.dataset.sending || "Enviando...";

        const scheduleHideResult = () => {
            if (resultHideTimer !== null) clearTimeout(resultHideTimer);
            resultHideTimer = setTimeout(() => {
                result.classList.add("hidden");
                resultHideTimer = null;
            }, 6000);
        };

        const showErrorBanner = (message: string) => {
            resultMessage.textContent = message;
            result.classList.remove("hidden");
            scheduleHideResult();
        };

        form.addEventListener(
            "submit",
            async (e) => {
                e.preventDefault();

                if (resultHideTimer !== null) {
                    clearTimeout(resultHideTimer);
                    resultHideTimer = null;
                }

                submitBtn.disabled = true;
                submitBtn.setAttribute("aria-busy", "true");
                form.setAttribute("aria-busy", "true");
                submitText.textContent = sendingText;
                result.classList.add("hidden");

                if (fetchAbortController) fetchAbortController.abort();
                const reqController = new AbortController();
                fetchAbortController = reqController;

                let timedOut = false;
                const timeoutId = setTimeout(() => {
                    timedOut = true;
                    reqController.abort();
                }, 15000);

                try {
                    const formData = new FormData(form);
                    const payload = JSON.stringify(Object.fromEntries(formData));

                    const response = await fetch("https://api.web3forms.com/submit", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json",
                        },
                        body: payload,
                        signal: reqController.signal,
                    });

                    const jsonResponse = await response.json();

                    if (response.ok && jsonResponse.success !== false) {
                        result.classList.add("hidden");
                        const successState = document.getElementById("success-state");
                        if (successState) {
                            form.classList.add("hidden");
                            successState.classList.remove("hidden");
                            successState.classList.add("flex");
                            successState.focus();

                            const resetBtn = document.getElementById("reset-form");
                            resetBtn?.addEventListener(
                                "click",
                                () => {
                                    successState.classList.add("hidden");
                                    successState.classList.remove("flex");
                                    form.classList.remove("hidden");
                                    form.reset();
                                    if (messageTextarea) {
                                        messageTextarea.style.height = "auto";
                                    }
                                },
                                { once: true, signal },
                            );
                        }
                    } else {
                        showErrorBanner(result.dataset.error || "Error");
                    }
                } catch (err) {
                    if (err instanceof Error && err.name === "AbortError") {
                        if (timedOut) {
                            showErrorBanner(
                                result.dataset.timeoutError || result.dataset.error || "Error",
                            );
                        }
                    } else {
                        showErrorBanner(result.dataset.error || "Error");
                    }
                } finally {
                    clearTimeout(timeoutId);
                    if (fetchAbortController === reqController) {
                        fetchAbortController = null;
                    }
                    if (!signal.aborted) {
                        submitBtn.disabled = false;
                        submitBtn.removeAttribute("aria-busy");
                        form.removeAttribute("aria-busy");
                        submitText.textContent = originalText;
                    }
                }
            },
            { signal },
        );
    }

    document.addEventListener("astro:before-swap", cleanupContactForm);
    document.addEventListener("astro:page-load", initContactForm);
</script>
