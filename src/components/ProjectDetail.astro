---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import ProjectGallery from "./ProjectGallery.astro";
import type { Project } from "../data/projects";
import { projects } from "../data/projects";
import { useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

interface Props {
    project: Project;
    lang: "es" | "en";
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

const projectTitle = project.title[lang];

// Previous and next projects for pagination
const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const prevProject = projects[(currentIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(currentIndex + 1) % projects.length];

const prevUrl = lang === "en" ? `/en/proyectos/${prevProject.slug}` : `/proyectos/${prevProject.slug}`;
const nextUrl = lang === "en" ? `/en/proyectos/${nextProject.slug}` : `/proyectos/${nextProject.slug}`;
const homeProjectsUrl = lang === "en" ? "/en#proyectos" : "/#proyectos";

const siteUrl = "https://martinratti.com.ar";
const homeUrl = lang === "en" ? `${siteUrl}/en` : siteUrl;
const projectPageUrl = lang === "en"
    ? `${siteUrl}/en/proyectos/${project.slug}`
    : `${siteUrl}/proyectos/${project.slug}`;

const projectJsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "SoftwareSourceCode",
        "name": projectTitle,
        "description": project.description[lang],
        "url": projectPageUrl,
        "image": new URL(project.coverImage, siteUrl).href,
        "codeRepository": project.repo,
        "programmingLanguage": project.tags,
        "inLanguage": lang === "en" ? "en-US" : "es-AR",
        "author": {
            "@type": "Person",
            "name": "Martín Ratti",
            "url": siteUrl,
        },
        ...(project.link ? { "mainEntityOfPage": project.link } : {}),
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Portfolio",
                "item": homeUrl,
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": t("nav.projects"),
                "item": `${homeUrl}#proyectos`,
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": projectTitle,
                "item": projectPageUrl,
            },
        ],
    },
];
---

<Layout
    title={`${projectTitle} | Martín Ratti`}
    description={project.description[lang]}
    image={project.coverImage}
    jsonLd={projectJsonLd}
>
    <Navbar />

    <main id="main-content" class="min-h-screen pt-24 sm:pt-28 pb-16 sm:pb-20 px-4 max-w-5xl mx-auto">
        <!-- Breadcrumb / Back Button -->
        <div class="mb-6 sm:mb-8">
            <a
                href={homeProjectsUrl}
                class="inline-flex items-center gap-2 px-4 py-2 min-h-[40px] rounded-full glass-card text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-300 hover:border-violet-500/50 transition-all duration-300 group"
            >
                <Icon name="mdi:arrow-left" class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" aria-hidden="true" />
                {t("project.back")}
            </a>
        </div>

        <!-- Hero Header -->
        <header class="mb-8 sm:mb-10">
            <!-- Meta Pills -->
            <div class="flex flex-wrap items-center gap-2 mb-4">
                {
                    project.role && (
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-violet-600/15 text-violet-700 dark:text-violet-300 border border-violet-500/30">
                            {project.role[lang]}
                        </span>
                    )
                }
                {
                    project.period && (
                        <span class="px-3 py-1 text-xs font-medium rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700/60">
                            {project.period}
                        </span>
                    )
                }
                {
                    project.featured && (
                        <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-linear-to-r from-violet-600 to-cyan-500 text-white shadow-sm">
                            {t("project.featured")}
                        </span>
                    )
                }
            </div>

            <!-- Title & Tagline -->
            <h1 class="text-[1.85rem] sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4 leading-[1.12]">
                <span class="text-gradient">{projectTitle}</span>
            </h1>

            <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-normal leading-relaxed max-w-3xl mb-6 sm:mb-8">
                {project.tagline?.[lang] || project.description[lang]}
            </p>

            <!-- Action Buttons & Links -->
            <div class="flex flex-wrap items-center gap-3 mb-6 sm:mb-8">
                {
                    project.link && (
                        <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 min-h-[44px] rounded-xl font-semibold text-sm text-white bg-violet-600 hover:bg-violet-500 shadow-lg shadow-violet-600/30 transition-all hover:scale-102 active:scale-98"
                        >
                            <Icon name="mdi:open-in-new" class="w-4 h-4 shrink-0" aria-hidden="true" />
                            {t("project.liveDemo")}
                        </a>
                    )
                }

                <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 min-h-[44px] rounded-xl font-semibold text-sm glass-card text-slate-800 dark:text-slate-200 hover:text-violet-600 dark:hover:text-violet-300 hover:border-violet-500/50 transition-all hover:scale-102 active:scale-98"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
                    </svg>
                    {t("project.sourceCode")}
                </a>
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-2 pt-3 border-t border-slate-200/60 dark:border-slate-800/60">
                {
                    project.tags.map((tag) => (
                        <span class="px-3 py-1 text-xs font-medium text-violet-700 dark:text-violet-300 bg-violet-100/80 dark:bg-violet-900/30 rounded-full border border-violet-200 dark:border-violet-800/50">
                            {tag}
                        </span>
                    ))
                }
            </div>
        </header>

        <!-- Project Screenshot Gallery with Connected View Transition & Native Dialog Lightbox -->
        <ProjectGallery
            images={project.gallery}
            projectTitle={projectTitle}
            coverTransitionName={`project-cover-${project.slug}`}
        />

        <!-- Deep Case Study Sections -->
        <div class="mt-10 sm:mt-14 space-y-8 sm:space-y-12">
            <!-- Overview & Narrative -->
            <section class="glass-card rounded-2xl p-5 sm:p-6 md:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2.5">
                    <span class="w-2 h-6 rounded-full bg-violet-600 inline-block" aria-hidden="true"></span>
                    {t("project.overview")}
                </h2>
                <div class="text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base md:text-lg space-y-4">
                    <p>{project.fullDescription?.[lang] || project.description[lang]}</p>
                </div>
            </section>

            <!-- Key Features -->
            {
                project.features && project.features.length > 0 && (
                    <section>
                        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-5 sm:mb-6 flex items-center gap-2.5">
                            <span class="w-2 h-6 rounded-full bg-cyan-500 inline-block" aria-hidden="true"></span>
                            {t("project.features")}
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {project.features.map((feat) => (
                                <div class="glass-card rounded-xl p-4 sm:p-5 hover:border-violet-500/40 transition duration-300 flex flex-col justify-between">
                                    <div>
                                        <div class="flex items-center gap-2 mb-2 text-violet-600 dark:text-violet-400 font-bold text-base sm:text-lg">
                                            <Icon name="mdi:check" class="w-4.5 h-4.5 shrink-0" aria-hidden="true" />
                                            <span>{feat.title[lang]}</span>
                                        </div>
                                        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                                            {feat.desc[lang]}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            <!-- Technical Architecture & Challenges -->
            {
                (project.architecture || project.challenges) && (
                    <section class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
                        {project.architecture && (
                            <div class="glass-card rounded-2xl p-5 sm:p-6 md:p-8 flex flex-col justify-between">
                                <div>
                                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
                                        <Icon name="mdi:layers-outline" class="w-5 h-5 text-violet-500 shrink-0" aria-hidden="true" />
                                        {t("project.architecture")}
                                    </h3>
                                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                                        {project.architecture[lang]}
                                    </p>
                                </div>
                            </div>
                        )}

                        {project.challenges && (
                            <div class="glass-card rounded-2xl p-5 sm:p-6 md:p-8 flex flex-col justify-between">
                                <div>
                                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
                                        <Icon name="mdi:lightbulb-on-outline" class="w-5 h-5 text-amber-500 shrink-0" aria-hidden="true" />
                                        {t("project.challenges")}
                                    </h3>
                                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                                        {project.challenges[lang]}
                                    </p>
                                </div>
                            </div>
                        )}
                    </section>
                )
            }
        </div>

        <!-- Project Pagination (Previous / Next) -->
        <nav class="mt-12 sm:mt-16 pt-8 border-t border-slate-200 dark:border-slate-800/80 flex flex-col gap-4" aria-label={t("project.pagination.aria")}>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <a
                    href={prevUrl}
                    class="min-h-[68px] inline-flex items-center gap-3 p-4 rounded-xl glass-card text-left hover:border-violet-500/50 transition group"
                >
                    <Icon name="mdi:chevron-left" class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform shrink-0 text-slate-500 dark:text-slate-400" aria-hidden="true" />
                    <div class="min-w-0">
                        <span class="text-xs text-slate-500 dark:text-slate-400 block">{t("project.prev")}</span>
                        <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors line-clamp-1">{prevProject.title[lang]}</span>
                    </div>
                </a>

                <a
                    href={nextUrl}
                    class="min-h-[68px] inline-flex items-center justify-between sm:justify-end gap-3 p-4 rounded-xl glass-card text-left sm:text-right hover:border-violet-500/50 transition group"
                >
                    <div class="min-w-0">
                        <span class="text-xs text-slate-500 dark:text-slate-400 block">{t("project.next")}</span>
                        <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors line-clamp-1">{nextProject.title[lang]}</span>
                    </div>
                    <Icon name="mdi:chevron-right" class="w-5 h-5 transform group-hover:translate-x-1 transition-transform shrink-0 text-slate-500 dark:text-slate-400" aria-hidden="true" />
                </a>
            </div>

            <div class="flex justify-center">
                <a
                    href={homeProjectsUrl}
                    class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-slate-500 hover:text-violet-600 dark:hover:text-white transition px-4 py-2 min-h-[36px]"
                >
                    {t("project.back")}
                </a>
            </div>
        </nav>
    </main>

    <Footer />
</Layout>
