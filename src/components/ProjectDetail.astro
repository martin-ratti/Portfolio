---
import Layout from "../layouts/Layout.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import ProjectGallery from "./ProjectGallery.astro";
import type { Project } from "../data/projects";
import { projects } from "../data/projects";
import { useTranslations } from "../i18n/utils";

interface Props {
    project: Project;
    lang: "es" | "en";
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

// Previous and next projects for pagination
const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const prevProject = projects[(currentIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(currentIndex + 1) % projects.length];

const prevUrl = lang === "en" ? `/en/proyectos/${prevProject.slug}` : `/proyectos/${prevProject.slug}`;
const nextUrl = lang === "en" ? `/en/proyectos/${nextProject.slug}` : `/proyectos/${nextProject.slug}`;
const homeProjectsUrl = lang === "en" ? "/en#proyectos" : "/#proyectos";
---

<Layout
    title={`${project.title} | Martín Ratti`}
    description={project.description[lang]}
    image={project.coverImage}
>
    <Navbar />

    <main id="main-content" class="min-h-screen pt-28 pb-20 px-4 max-w-5xl mx-auto">
        <!-- Breadcrumb / Back Button -->
        <div class="mb-8 animate-fade-in-up">
            <a
                href={homeProjectsUrl}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-violet-600 dark:hover:text-violet-300 hover:border-violet-500/50 transition-all duration-300 group"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="m15 18-6-6 6-6" />
                </svg>
                {t("project.back")}
            </a>
        </div>

        <!-- Hero Header -->
        <header class="mb-10 animate-fade-in-up">
            <!-- Meta Pills -->
            <div class="flex flex-wrap items-center gap-2.5 mb-4">
                {
                    project.role && (
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-violet-600/15 text-violet-700 dark:text-violet-300 border border-violet-500/30">
                            {project.role[lang]}
                        </span>
                    )
                }
                {
                    project.period && (
                        <span class="px-3 py-1 text-xs font-medium rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700/60">
                            {project.period}
                        </span>
                    )
                }
                {
                    project.featured && (
                        <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-linear-to-r from-violet-600 to-cyan-500 text-white shadow-sm">
                            Featured
                        </span>
                    )
                }
            </div>

            <!-- Title & Tagline -->
            <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
                <span class="text-gradient leading-tight">{project.title}</span>
            </h1>

            <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 font-normal leading-relaxed max-w-3xl mb-8">
                {project.tagline?.[lang] || project.description[lang]}
            </p>

            <!-- Action Buttons & Links -->
            <div class="flex flex-wrap items-center gap-3.5 mb-8">
                {
                    project.link && (
                        <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm text-white bg-violet-600 hover:bg-violet-500 shadow-lg shadow-violet-600/30 transition-all hover:scale-102 active:scale-98"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                <polyline points="15 3 21 3 21 9" />
                                <line x1="10" y1="14" x2="21" y2="3" />
                            </svg>
                            {t("project.liveDemo")}
                        </a>
                    )
                }

                <a
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm glass-card text-slate-800 dark:text-slate-200 hover:text-violet-600 dark:hover:text-violet-300 hover:border-violet-500/50 transition-all hover:scale-102 active:scale-98"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
                    </svg>
                    {t("project.sourceCode")}
                </a>
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-2 pt-2 border-t border-slate-200/60 dark:border-slate-800/60">
                {
                    project.tags.map((tag) => (
                        <span class="px-3 py-1 text-xs font-medium text-violet-700 dark:text-violet-300 bg-violet-100/80 dark:bg-violet-900/30 rounded-full border border-violet-200 dark:border-violet-800/50">
                            {tag}
                        </span>
                    ))
                }
            </div>
        </header>

        <!-- Project Screenshot Gallery with Lightbox -->
        <ProjectGallery images={project.gallery} projectTitle={project.title} />

        <!-- Deep Case Study Sections -->
        <div class="mt-14 space-y-12">
            <!-- Overview & Narrative -->
            <section class="glass-card rounded-2xl p-6 md:p-8">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2.5">
                    <span class="w-2.5 h-6 rounded-full bg-violet-600 inline-block"></span>
                    {t("project.overview")}
                </h2>
                <div class="text-slate-700 dark:text-slate-300 leading-relaxed text-base sm:text-lg space-y-4">
                    <p>{project.fullDescription?.[lang] || project.description[lang]}</p>
                </div>
            </section>

            <!-- Key Features -->
            {
                project.features && project.features.length > 0 && (
                    <section>
                        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2.5">
                            <span class="w-2.5 h-6 rounded-full bg-cyan-500 inline-block"></span>
                            {t("project.features")}
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {project.features.map((feat) => (
                                <div class="glass-card rounded-xl p-5 hover:border-violet-500/40 transition duration-300 flex flex-col justify-between">
                                    <div>
                                        <div class="flex items-center gap-2 mb-2 text-violet-600 dark:text-violet-400 font-bold text-base sm:text-lg">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                            {feat.title[lang]}
                                        </div>
                                        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                                            {feat.desc[lang]}
                                        </p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            <!-- Technical Architecture & Challenges -->
            {
                (project.architecture || project.challenges) && (
                    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {project.architecture && (
                            <div class="glass-card rounded-2xl p-6 md:p-8 flex flex-col justify-between">
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-500" aria-hidden="true">
                                            <rect width="18" height="18" x="3" y="3" rx="2" />
                                            <path d="M3 9h18" />
                                            <path d="M9 21V9" />
                                        </svg>
                                        {t("project.architecture")}
                                    </h3>
                                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                                        {project.architecture[lang]}
                                    </p>
                                </div>
                            </div>
                        )}

                        {project.challenges && (
                            <div class="glass-card rounded-2xl p-6 md:p-8 flex flex-col justify-between">
                                <div>
                                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500" aria-hidden="true">
                                            <path d="M12 2v4" />
                                            <path d="m4.93 4.93 2.83 2.83" />
                                            <path d="M2 12h4" />
                                            <path d="m4.93 19.07 2.83-2.83" />
                                            <path d="M12 18v4" />
                                            <path d="m16.24 16.24 2.83 2.83" />
                                            <path d="M18 12h4" />
                                            <path d="m16.24 7.76 2.83-2.83" />
                                        </svg>
                                        {t("project.challenges")}
                                    </h3>
                                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                                        {project.challenges[lang]}
                                    </p>
                                </div>
                            </div>
                        )}
                    </section>
                )
            }
        </div>

        <!-- Project Pagination (Previous / Next) -->
        <nav class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4" aria-label="Navegación entre proyectos">
            <a
                href={prevUrl}
                class="w-full sm:w-auto inline-flex items-center gap-3 p-4 rounded-xl glass-card text-left hover:border-violet-500/50 transition group"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-1 transition-transform shrink-0" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" />
                </svg>
                <div>
                    <span class="text-xs text-slate-500 dark:text-slate-400 block">{t("project.prev")}</span>
                    <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-violet-500 transition-colors line-clamp-1">{prevProject.title}</span>
                </div>
            </a>

            <a
                href={homeProjectsUrl}
                class="text-xs font-semibold uppercase tracking-wider text-slate-500 hover:text-violet-600 dark:hover:text-white transition px-4 py-2"
            >
                {t("project.back")}
            </a>

            <a
                href={nextUrl}
                class="w-full sm:w-auto inline-flex items-center justify-end gap-3 p-4 rounded-xl glass-card text-right hover:border-violet-500/50 transition group"
            >
                <div>
                    <span class="text-xs text-slate-500 dark:text-slate-400 block">{t("project.next")}</span>
                    <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-violet-500 transition-colors line-clamp-1">{nextProject.title}</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-1 transition-transform shrink-0" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </a>
        </nav>
    </main>

    <Footer />
</Layout>
