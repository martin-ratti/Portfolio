---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
    id="chat-widget"
    class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-4 z-50 flex flex-col items-end pointer-events-none"
    data-lang={lang}
    data-error-server={t("chat.error.server")}
    data-error-connection={t("chat.error.connection")}
    data-error-invalid={t("chat.error.invalid")}
    data-error-rate-limit={t("chat.error.rateLimit")}
    data-error-timeout={t("chat.error.timeout")}
    data-error-prefix={t("chat.error.prefix")}
    data-label-open={t("chat.open.aria")}
    data-label-close={t("chat.close.aria")}
>
    <!-- Chat Dialog Window -->
    <div
        id="chat-window"
        role="dialog"
        aria-label={t("chat.name")}
        inert
        aria-hidden="true"
        class="absolute bottom-16 right-0 w-[370px] max-w-[calc(100vw-1.5rem)] h-[min(580px,78dvh)] flex flex-col bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-slate-200/90 dark:border-white/10 rounded-2xl shadow-2xl overflow-hidden origin-bottom-right transition-[transform,opacity] duration-200 invisible opacity-0 scale-95 pointer-events-none"
    >
        <!-- Header -->
        <div
            class="px-4 py-3 border-b border-slate-200/80 dark:border-white/10 bg-white/60 dark:bg-black/20 flex justify-between items-center gap-2"
        >
            <div class="flex items-center gap-3 min-w-0">
                <div class="relative shrink-0">
                    <div
                        class="w-2.5 h-2.5 absolute bottom-0 right-0 bg-emerald-500 rounded-full ring-2 ring-white dark:ring-slate-900"
                        aria-hidden="true"
                    >
                    </div>
                    <div
                        class="w-8 h-8 rounded-full bg-linear-to-tr from-violet-500 to-fuchsia-500 flex items-center justify-center text-white text-xs font-bold"
                        aria-hidden="true"
                    >
                        AI
                    </div>
                </div>
                <div class="min-w-0">
                    <h3 class="font-bold text-sm text-slate-900 dark:text-white leading-tight truncate">
                        {t("chat.name")}
                    </h3>
                    <a
                        href="/llms.txt"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[11px] text-slate-500 dark:text-slate-400 hover:text-violet-600 dark:hover:text-violet-300 transition-colors"
                    >
                        {t("chat.powered")}
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-1 shrink-0">
                <button
                    id="reset-chat"
                    type="button"
                    aria-label={t("chat.reset.aria")}
                    title={t("chat.reset.title")}
                    class="min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-slate-500 hover:text-violet-600 dark:text-slate-400 dark:hover:text-violet-300 hover:bg-slate-200/70 dark:hover:bg-slate-800/80 transition-colors cursor-pointer"
                >
                    <Icon name="mdi:refresh" class="w-4.5 h-4.5" aria-hidden="true" />
                </button>
                <button
                    id="close-chat"
                    type="button"
                    aria-label={t("chat.close.aria")}
                    class="min-w-[44px] min-h-[44px] rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white hover:bg-slate-200/70 dark:hover:bg-slate-800/80 transition-colors cursor-pointer"
                >
                    <Icon name="mdi:close" class="w-5 h-5" aria-hidden="true" />
                </button>
            </div>
        </div>

        <!-- Messages -->
        <div
            id="messages-container"
            role="log"
            aria-live="polite"
            aria-atomic="false"
            class="flex-1 overflow-y-auto p-4 space-y-4 scroll-smooth"
        >
            <div class="flex gap-3" data-initial-greeting="true">
                <div
                    class="w-8 h-8 rounded-full bg-linear-to-tr from-violet-500 to-fuchsia-500 shrink-0 flex items-center justify-center text-white text-xs font-bold"
                    aria-hidden="true"
                >
                    AI
                </div>
                <div
                    class="bg-white dark:bg-slate-800 p-3 rounded-2xl rounded-tl-none border border-black/5 dark:border-white/10 shadow-sm max-w-[85%]"
                >
                    <p class="text-sm text-slate-600 dark:text-slate-300">
                        {t("chat.greeting")}
                        <Icon name="mdi:hand-wave" class="w-4 h-4 text-amber-500 inline-block align-text-bottom ml-1" aria-hidden="true" />
                    </p>
                </div>
            </div>
        </div>

        <!-- Chips + Input Form -->
        <div
            class="p-3 sm:p-4 border-t border-slate-200/80 dark:border-white/10 bg-white/60 dark:bg-black/20"
        >
            <div
                id="chips-container"
                class="flex flex-nowrap gap-2 overflow-x-auto pb-2 mb-1 transition-opacity duration-300 items-center snap-x snap-mandatory custom-scrollbar"
            >
                <button
                    type="button"
                    class="chat-chip group flex items-center gap-2 whitespace-nowrap px-3.5 py-2 rounded-full text-xs font-medium bg-white/85 dark:bg-slate-800/85 border border-slate-200 dark:border-white/10 hover:border-violet-500 dark:hover:border-violet-400 hover:bg-violet-50 dark:hover:bg-violet-500/10 transition-colors cursor-pointer text-slate-700 dark:text-slate-200 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    data-message={t("chat.suggestion1")}
                >
                    <Icon name="simple-icons:astro" class="w-3.5 h-3.5 text-violet-500 shrink-0" aria-hidden="true" />
                    <span>{t("chat.suggestion1")}</span>
                </button>
                <button
                    type="button"
                    class="chat-chip group flex items-center gap-2 whitespace-nowrap px-3.5 py-2 rounded-full text-xs font-medium bg-white/85 dark:bg-slate-800/85 border border-slate-200 dark:border-white/10 hover:border-violet-500 dark:hover:border-violet-400 hover:bg-violet-50 dark:hover:bg-violet-500/10 transition-colors cursor-pointer text-slate-700 dark:text-slate-200 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    data-message={t("chat.suggestion2")}
                >
                    <Icon name="mdi:layers-outline" class="w-3.5 h-3.5 text-fuchsia-500 shrink-0" aria-hidden="true" />
                    <span>{t("chat.suggestion2")}</span>
                </button>
                <button
                    type="button"
                    class="chat-chip group flex items-center gap-2 whitespace-nowrap px-3.5 py-2 rounded-full text-xs font-medium bg-white/85 dark:bg-slate-800/85 border border-slate-200 dark:border-white/10 hover:border-violet-500 dark:hover:border-violet-400 hover:bg-violet-50 dark:hover:bg-violet-500/10 transition-colors cursor-pointer text-slate-700 dark:text-slate-200 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    data-message={t("chat.suggestion3")}
                >
                    <Icon name="mdi:code-tags" class="w-3.5 h-3.5 text-cyan-500 shrink-0" aria-hidden="true" />
                    <span>{t("chat.suggestion3")}</span>
                </button>
            </div>

            <form id="chat-form" class="relative">
                <label for="chat-input" class="sr-only">{t("chat.input.label")}</label>
                <input
                    type="text"
                    id="chat-input"
                    maxlength="1500"
                    enterkeyhint="send"
                    autocomplete="off"
                    placeholder={t("chat.placeholder")}
                    class="w-full min-h-[46px] bg-white dark:bg-slate-800 border border-slate-300/80 dark:border-white/10 rounded-xl pl-4 pr-12 py-2.5 text-base focus:outline-none focus:ring-2 focus:ring-violet-500 dark:text-white placeholder-slate-400 disabled:opacity-60 disabled:cursor-not-allowed"
                />
                <button
                    type="submit"
                    id="chat-submit"
                    aria-label={t("chat.send.aria")}
                    class="absolute right-1.5 top-1/2 -translate-y-1/2 min-w-[38px] min-h-[38px] flex items-center justify-center bg-violet-600 hover:bg-violet-700 text-white rounded-lg transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    <Icon name="mdi:send-outline" class="w-4 h-4" aria-hidden="true" />
                </button>
            </form>
        </div>
    </div>

    <!-- Refined Floating Trigger Button -->
    <button
        id="chat-toggle"
        type="button"
        class="pointer-events-auto group relative flex items-center justify-center gap-2 h-13 w-13 sm:w-auto sm:px-4 bg-slate-900/95 dark:bg-slate-900/95 text-white rounded-full border border-violet-500/40 hover:border-violet-400 shadow-xl shadow-violet-950/25 hover:-translate-y-0.5 transition-[transform,background-color,border-color] duration-200 z-50 cursor-pointer backdrop-blur-md"
        aria-label={t("chat.open.aria")}
        aria-expanded="false"
        aria-controls="chat-window"
    >
        <span id="toggle-open-content" class="flex items-center gap-2">
            <span class="relative flex items-center justify-center">
                <Icon name="mdi:creation-outline" class="w-5 h-5 text-violet-300" aria-hidden="true" />
                <span
                    class="sm:hidden absolute -top-1 -right-1 h-2.5 w-2.5 rounded-full bg-emerald-400 border-2 border-slate-900"
                    aria-hidden="true"
                ></span>
            </span>
            <span class="hidden sm:inline text-xs font-semibold tracking-wide text-slate-100">
                {t("chat.name")}
            </span>
            <span
                class="hidden sm:inline-block h-2 w-2 rounded-full bg-emerald-400"
                aria-hidden="true"
            ></span>
        </span>

        <span id="icon-close" class="hidden items-center justify-center">
            <Icon name="mdi:close" class="w-5 h-5 text-slate-100" aria-hidden="true" />
        </span>
    </button>

    <script>
        import type { ChatMessage } from "../utils/chat/chatApi";

        type ChatModules = {
            chatApi: typeof import("../utils/chat/chatApi");
            chatUi: typeof import("../utils/chat/chatUi");
        };

        const MAX_HISTORY_MESSAGES = 16;

        let chatModulesPromise: Promise<ChatModules> | null = null;
        let cachedChatModules: ChatModules | null = null;

        function loadChatModules(): Promise<ChatModules> {
            if (!chatModulesPromise) {
                chatModulesPromise = Promise.all([
                    import("../utils/chat/chatApi"),
                    import("../utils/chat/chatUi"),
                ]).then(([chatApi, chatUi]) => {
                    cachedChatModules = { chatApi, chatUi };
                    return cachedChatModules;
                });
            }
            return chatModulesPromise;
        }

        interface StoredChatMessage extends ChatMessage {
            isError?: boolean;
        }

        let isOpen = false;
        let isSending = false;
        let messages: StoredChatMessage[] = [];
        let chatAbortController: AbortController | null = null;
        let activeRequestController: AbortController | null = null;

        let widget: HTMLElement | null = null;
        let toggleBtn: HTMLElement | null = null;
        let windowEl: HTMLElement | null = null;
        let closeBtn: HTMLElement | null = null;
        let resetBtn: HTMLElement | null = null;
        let form: HTMLFormElement | null = null;
        let input: HTMLInputElement | null = null;
        let submitBtn: HTMLButtonElement | null = null;
        let messagesContainer: HTMLElement | null = null;
        let toggleOpenContent: HTMLElement | null = null;
        let closeIcon: HTMLElement | null = null;
        let chipsContainer: HTMLElement | null = null;

        let currentLang = "es";
        let errServer = "Lo siento, no pude conectar con el servidor.";
        let errConnection = "Lo siento, hubo un error de conexión.";
        let errInvalid = "Formato de respuesta inválido del servidor.";
        let errRateLimit = "Demasiadas consultas seguidas. Espera un minuto e inténtalo de nuevo.";
        let errTimeout = "El asistente tardó demasiado en responder. Inténtalo de nuevo.";
        let errPrefix = "Error:";
        let labelOpen = "Abrir chat con Martín AI";
        let labelClose = "Cerrar chat con Martín AI";

        function setSendingState(sending: boolean) {
            isSending = sending;
            if (input) input.disabled = sending;
            if (submitBtn) submitBtn.disabled = sending;
            document.querySelectorAll<HTMLButtonElement>(".chat-chip").forEach((chip) => {
                chip.disabled = sending;
            });
        }

        function syncToggleVisual(open: boolean) {
            if (open) {
                toggleOpenContent?.classList.add("hidden");
                closeIcon?.classList.remove("hidden");
                closeIcon?.classList.add("flex");
                toggleBtn?.classList.remove("sm:w-auto", "sm:px-4");
            } else {
                toggleOpenContent?.classList.remove("hidden");
                closeIcon?.classList.add("hidden");
                closeIcon?.classList.remove("flex");
                toggleBtn?.classList.add("sm:w-auto", "sm:px-4");
            }
        }

        async function applyChatOpenState(open: boolean, manageFocus = true) {
            isOpen = open;
            toggleBtn?.setAttribute("aria-expanded", open ? "true" : "false");
            toggleBtn?.setAttribute("aria-label", open ? labelClose : labelOpen);
            syncToggleVisual(open);

            if (open) {
                windowEl?.classList.remove(
                    "invisible",
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                windowEl?.classList.add("opacity-100", "scale-100", "pointer-events-auto");
                windowEl?.removeAttribute("inert");
                windowEl?.setAttribute("aria-hidden", "false");

                const { chatUi } = await loadChatModules();
                if (isOpen && windowEl && toggleBtn) {
                    chatUi.setupFocusTrap(windowEl, toggleBtn);
                }

                if (manageFocus && isOpen) {
                    setTimeout(() => input?.focus(), 200);
                }
            } else {
                windowEl?.classList.add(
                    "invisible",
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                );
                windowEl?.classList.remove("opacity-100", "scale-100", "pointer-events-auto");
                windowEl?.setAttribute("inert", "");
                windowEl?.setAttribute("aria-hidden", "true");

                cachedChatModules?.chatUi.releaseFocusTrap(manageFocus);
            }
        }

        function toggleChat() {
            void applyChatOpenState(!isOpen, true);
        }

        function resetChat() {
            if (activeRequestController) {
                activeRequestController.abort();
                activeRequestController = null;
            }
            cachedChatModules?.chatUi.hideTypingIndicator();
            setSendingState(false);
            messages = [];

            if (messagesContainer) {
                Array.from(messagesContainer.children).forEach((child) => {
                    if (!(child instanceof HTMLElement) || child.dataset.initialGreeting !== "true") {
                        child.remove();
                    }
                });
            }

            if (chipsContainer) {
                chipsContainer.classList.remove("hidden", "opacity-0", "pointer-events-none");
            }

            if (isOpen) {
                input?.focus();
            }
        }

        function handleKeyDown(e: KeyboardEvent) {
            if (e.key === "Escape" && isOpen) {
                e.preventDefault();
                void applyChatOpenState(false, true);
            }
        }

        async function sendMessage(text: string) {
            if (!messagesContainer || isSending) return;

            setSendingState(true);
            const { chatApi, chatUi } = await loadChatModules();

            chatUi.addMessageToDOM(messagesContainer, "user", text);
            if (input) input.value = "";

            const apiHistory: ChatMessage[] = messages
                .filter((m) => !m.isError)
                .slice(-(MAX_HISTORY_MESSAGES - 1))
                .map(({ role, content }) => ({ role, content }));
            apiHistory.push({ role: "user", content: text });

            chatUi.showTypingIndicator(messagesContainer);

            if (activeRequestController) activeRequestController.abort();
            const requestController = new AbortController();
            activeRequestController = requestController;

            try {
                const response = await chatApi.sendChatMessage(
                    apiHistory,
                    currentLang,
                    errInvalid,
                    requestController.signal,
                );
                chatUi.hideTypingIndicator();

                if (response.aborted) {
                    return;
                }

                if (response.errorCode === "RATE_LIMIT") {
                    chatUi.addMessageToDOM(messagesContainer, "assistant", errRateLimit, true);
                } else if (response.errorCode === "TIMEOUT") {
                    chatUi.addMessageToDOM(messagesContainer, "assistant", errTimeout, true);
                } else if (response.errorCode === "NETWORK") {
                    chatUi.addMessageToDOM(messagesContainer, "assistant", errServer, true);
                } else if (response.error) {
                    chatUi.addMessageToDOM(
                        messagesContainer,
                        "assistant",
                        `**${errPrefix}** ${response.error}`,
                        true,
                    );
                } else if (response.reply) {
                    chatUi.addMessageToDOM(messagesContainer, "assistant", response.reply);
                    messages.push(
                        { role: "user", content: text },
                        { role: "assistant", content: response.reply },
                    );
                } else {
                    chatUi.addMessageToDOM(messagesContainer, "assistant", errConnection, true);
                }
            } finally {
                if (activeRequestController === requestController) {
                    activeRequestController = null;
                }
                chatUi.hideTypingIndicator();
                setSendingState(false);
                if (isOpen) {
                    input?.focus();
                }
            }
        }

        function handleChatSubmit(e: SubmitEvent) {
            e.preventDefault();
            if (!input || isSending) return;

            const text = input.value.trim();
            if (!text) return;

            void sendMessage(text);
        }

        function handleChipClick(e: Event) {
            if (isSending) return;
            const btn = (e.currentTarget as HTMLElement).closest(".chat-chip") as HTMLButtonElement;
            const message = btn?.dataset.message;
            if (message) {
                void sendMessage(message);

                if (chipsContainer) {
                    chipsContainer.classList.add("opacity-0", "pointer-events-none");
                    setTimeout(() => {
                        chipsContainer?.classList.add("hidden");
                    }, 300);
                }
            }
        }

        function cleanupChatWidget() {
            if (chatAbortController) {
                chatAbortController.abort();
                chatAbortController = null;
            }
            if (activeRequestController) {
                activeRequestController.abort();
                activeRequestController = null;
            }
        }

        function initChatWidget() {
            cleanupChatWidget();
            chatAbortController = new AbortController();
            const { signal } = chatAbortController;

            widget = document.getElementById("chat-widget");
            toggleBtn = document.getElementById("chat-toggle");
            windowEl = document.getElementById("chat-window");
            closeBtn = document.getElementById("close-chat");
            resetBtn = document.getElementById("reset-chat");
            form = document.getElementById("chat-form") as HTMLFormElement;
            input = document.getElementById("chat-input") as HTMLInputElement;
            submitBtn = document.getElementById("chat-submit") as HTMLButtonElement;
            messagesContainer = document.getElementById("messages-container");
            toggleOpenContent = document.getElementById("toggle-open-content");
            closeIcon = document.getElementById("icon-close");
            chipsContainer = document.getElementById("chips-container");

            if (widget) {
                currentLang = widget.dataset.lang || "es";
                errServer =
                    widget.dataset.errorServer ||
                    "Lo siento, no pude conectar con el servidor.";
                errConnection =
                    widget.dataset.errorConnection ||
                    "Lo siento, hubo un error de conexión.";
                errInvalid =
                    widget.dataset.errorInvalid ||
                    "Formato de respuesta inválido del servidor.";
                errRateLimit =
                    widget.dataset.errorRateLimit ||
                    "Demasiadas consultas seguidas. Espera un minuto e inténtalo de nuevo.";
                errTimeout =
                    widget.dataset.errorTimeout ||
                    "El asistente tardó demasiado en responder. Inténtalo de nuevo.";
                errPrefix = widget.dataset.errorPrefix || "Error:";
                labelOpen = widget.dataset.labelOpen || "Abrir chat con Martín AI";
                labelClose = widget.dataset.labelClose || "Cerrar chat con Martín AI";
            }

            // Re-sync isOpen state with the fresh DOM after view transition / language swap
            const domIsClosed =
                !windowEl ||
                windowEl.hasAttribute("inert") ||
                windowEl.getAttribute("aria-hidden") === "true";
            isOpen = !domIsClosed;
            isSending = false;
            void applyChatOpenState(isOpen, false);

            // Re-populate conversation history if messages exist across navigation
            if (messagesContainer && messages.length > 0) {
                chipsContainer?.classList.add("hidden");
                const targetContainer = messagesContainer;
                void loadChatModules().then(({ chatUi }) => {
                    for (const msg of messages) {
                        chatUi.addMessageToDOM(
                            targetContainer,
                            msg.role,
                            msg.content,
                            Boolean(msg.isError),
                        );
                    }
                });
            }

            toggleBtn?.addEventListener("click", toggleChat, { signal });
            closeBtn?.addEventListener("click", toggleChat, { signal });
            resetBtn?.addEventListener("click", resetChat, { signal });
            form?.addEventListener("submit", handleChatSubmit, { signal });
            document.addEventListener("keydown", handleKeyDown, { signal });

            document.querySelectorAll(".chat-chip").forEach((chip) => {
                chip.addEventListener("click", handleChipClick, { signal });
            });

            // Preload modules on hover/focus without intrusive tooltip timers
            toggleBtn?.addEventListener(
                "mouseenter",
                () => {
                    void loadChatModules();
                },
                { signal },
            );
            toggleBtn?.addEventListener(
                "focus",
                () => {
                    void loadChatModules();
                },
                { signal },
            );
        }

        document.addEventListener("astro:before-swap", cleanupChatWidget);
        document.addEventListener("astro:page-load", initChatWidget);
    </script>

    <style is:global>
        /* Scoped Markdown styles inside chat widget only */
        #chat-widget .prose p {
            margin-bottom: 0.75em;
            line-height: 1.6;
        }
        #chat-widget .prose p:last-child {
            margin-bottom: 0;
        }
        #chat-widget .prose strong {
            font-weight: 700;
            color: inherit;
        }
        #chat-widget .prose a {
            color: #d946ef;
            font-weight: 600;
            text-decoration: underline;
            text-decoration-color: transparent;
            text-underline-offset: 0.2em;
            text-decoration-thickness: 1px;
            transition: color 0.2s, text-decoration-color 0.2s;
        }
        #chat-widget .prose a:hover {
            color: #8b5cf6;
            text-decoration-color: currentColor;
        }
        .dark #chat-widget .prose a {
            color: #d946ef;
        }
        #chat-widget .prose ul,
        #chat-widget .prose ol {
            margin-left: 1.25em;
            margin-bottom: 0.75em;
        }
        #chat-widget .prose ul {
            list-style-type: disc;
        }
        #chat-widget .prose ol {
            list-style-type: decimal;
        }
        #chat-widget .prose li {
            margin-bottom: 0.35em;
        }
        #chat-widget .prose code {
            background-color: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
            padding: 0.2em 0.4em;
            border-radius: 0.375em;
            font-family: inherit;
            font-weight: 600;
            font-size: 0.9em;
        }
        .dark #chat-widget .prose code {
            background-color: rgba(217, 70, 239, 0.15);
            color: #f472b6;
        }
        #chat-widget .prose pre {
            background-color: #1e293b;
            color: #e2e8f0;
            padding: 0.75em;
            border-radius: 0.5em;
            overflow-x: auto;
            margin-bottom: 0.75em;
            font-size: 0.85em;
        }
        #chat-widget .prose pre code {
            background-color: transparent;
            padding: 0;
            color: inherit;
            font-weight: 400;
        }

        /* Custom Scrollbar for Chips */
        .custom-scrollbar {
            --scrollbar-thumb: rgba(139, 92, 246, 0.35);
            --scrollbar-track: rgba(0, 0, 0, 0.05);
            scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
            scrollbar-width: thin;
        }
        .dark .custom-scrollbar {
            --scrollbar-track: rgba(255, 255, 255, 0.05);
        }
        @supports not (scrollbar-color: auto) {
            .custom-scrollbar {
                scrollbar-width: auto;
            }
            .custom-scrollbar::-webkit-scrollbar {
                height: 4px;
            }
            .custom-scrollbar::-webkit-scrollbar-track {
                background: var(--scrollbar-track);
                border-radius: 10px;
            }
            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: var(--scrollbar-thumb);
                border-radius: 10px;
            }
            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: rgba(139, 92, 246, 0.5);
            }
        }

        .chat-chip {
            scroll-snap-align: start;
        }
    </style>
</div>
